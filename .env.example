# Copy to .env for local development. Real values live only in Vercel environment variables.
PUBLIC_SITE_URL=http://localhost:4321

# Database (Neon via Vercel Marketplace)
DATABASE_URL=
# Local previews and e2e without a database: keep JLPT runs in memory
JLPT_MEMORY_STORE=false

# Email (Resend)
RESEND_API_KEY=

# Bot protection (Cloudflare Turnstile)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Files (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Admin page (HTTP Basic auth; store a scrypt/argon2 hash, never the plain password)
ADMIN_USER=
ADMIN_PASSWORD_HASH=

# Privacy-preserving rate limiting
IP_HASH_SALT=

# Community
DISCORD_GUILD_ID=
YOUTUBE_CHANNEL_ID=

# Vercel Cron authorization
CRON_SECRET=
