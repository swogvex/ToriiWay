---
import PlayBlocked from '../../components/game/PlayBlocked.astro';
import PlayField from '../../components/game/PlayField.astro';
import PlayHud from '../../components/game/PlayHud.astro';
import PlayKeyboard from '../../components/game/PlayKeyboard.astro';
import { DIFFICULTIES, GAME_SCRIPTS, MODES } from '../../game/config';
import { getLocale, useTranslations } from '../../i18n';
import FocusLayout from '../../layouts/FocusLayout.astro';

const t = useTranslations(getLocale(Astro.url.pathname));
// Settings come from the URL in the browser, so the mode label is built there.
const labels = Object.fromEntries([
  ...GAME_SCRIPTS.map((key) => [key, t(`game.script.${key}`)]),
  ...DIFFICULTIES.map((key) => [key, t(`game.difficulty.${key}`)]),
  ...MODES.map((key) => [key, t(`game.mode.${key}`)]),
]);
---

<FocusLayout
  title={`${t('game.play.title')} · ${t('site.name')}`}
  description={t('game.play.description')}
  noindex
>
  <div class="kana-rush" data-game data-labels={JSON.stringify(labels)}>
    <section class="play column" aria-labelledby="play-title">
      <h1 id="play-title" class="visually-hidden">
        Kana Rush
      </h1>
      <PlayHud />
      <PlayField />
      <PlayKeyboard />
    </section>
    <PlayBlocked />
  </div>
</FocusLayout>

<script>
  import { initPlay } from '../../game/play';

  const root = document.querySelector<HTMLElement>('[data-game]');
  if (root) void initPlay(root);
</script>

<style>
  .play {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-4) var(--space-10);
  }

  .kana-rush :global(.blocked) {
    display: none;
  }

  /* Same query as BLOCKED in src/game/play.ts; "Play anyway" adds .is-forced. */
  @media (width < 1024px), not (pointer: fine) {
    .kana-rush:not(.is-forced) .play {
      display: none;
    }

    .kana-rush:not(.is-forced) :global(.blocked) {
      display: grid;
    }
  }
</style>
