---
import Leaderboard from '../../components/game/Leaderboard.astro';
import { getLocale, localizePath, useTranslations } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteKeyFor } from '../../lib/server/turnstile';
import { breadcrumbList, jsonLdGraph } from '../../lib/seo';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const site = Astro.site ?? new URL(Astro.url.origin);
const siteKey = siteKeyFor(process.env.VERCEL_ENV);

const breadcrumb = [
  { label: t('nav.home'), href: localizePath('/', locale) },
  { label: t('nav.game'), href: localizePath('/game', locale) },
  { label: t('game.board.title') },
];
const jsonLd = jsonLdGraph(breadcrumbList(breadcrumb, site, new URL(Astro.url.pathname, site)));
---

<BaseLayout
  title={`${t('game.board.metaTitle')} · ${t('site.name')}`}
  description={t('game.board.description')}
  breadcrumb={breadcrumb}
  jsonLd={jsonLd}
>
  <Leaderboard siteKey={siteKey} />
</BaseLayout>
