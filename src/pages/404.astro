---
import { getLocale, localizePath, useTranslations } from '../i18n';
import BareLayout from '../layouts/BareLayout.astro';
import { SECTIONS } from '../lib/nav';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const glyphs = ['迷', '子'];
---

<BareLayout
  title={`${t('notFound.title')} · ${t('site.name')}`}
  description={t('notFound.metaDescription')}
  noindex
>
  <main class="lost" id="main">
    <div class="lost__field" data-lost-field>
      {glyphs.map((glyph, index) => (
        <button
          class:list={['lost__glyph', `lost__glyph--${index + 1}`]}
          type="button"
          aria-label={t('notFound.glyph', { glyph })}
          aria-describedby="lost-help"
          data-lost-glyph
        >
          <span lang="ja">{glyph}</span>
        </button>
      ))}
      <p class="lost__hint" aria-hidden="true" data-lost-hint>
        {t('notFound.hint')}
        <svg class="lost__arrow" viewBox="0 0 40 40" focusable="false">
          <path d="M30 4c2 14-6 26-22 30"></path>
          <path d="M8 34l4-9M8 34l9 3"></path>
        </svg>
      </p>
    </div>
    <p class="visually-hidden" id="lost-help">
      {t('notFound.instructions')}
    </p>

    <div class="lost__ground column">
      <div class="lost__copy">
        <p class="lost__label">404</p>
        <h1 class="lost__title">{t('notFound.title')}</h1>
        <p class="lost__lead">{t('notFound.lead')}</p>
      </div>
      <nav class="lost__nav" aria-labelledby="lost-links">
        <h2 class="lost__label" id="lost-links">
          {t('notFound.links')}
        </h2>
        <ul class="lost__links">
          {SECTIONS.map((section) => (
            <li>
              <a href={localizePath(section.href, locale)}>{t(`nav.${section.id}`)}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
</BareLayout>

<script>
  import { initPlayground } from '../lib/lost/playground';

  const field = document.querySelector<HTMLElement>('[data-lost-field]');
  if (field && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    initPlayground(field);
  }
</script>

<style>
  /* One screen, no scroll: the playground above, the message below the ground line. */
  .lost {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    block-size: 100dvh;
    overflow: hidden;
  }

  .lost__field {
    --glyph: min(30vmin, 240px, 40dvh);

    position: relative;
    border-block-end: 1px solid var(--ink);
  }

  .lost__glyph {
    position: absolute;
    inset-block-end: 0;
    display: grid;
    place-items: center;
    inline-size: var(--glyph);
    block-size: var(--glyph);
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-display-ja);
    font-size: calc(var(--glyph) * 0.9);
    font-weight: 700;
    line-height: 1;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  /* The global :lang(ja) line-height would push the glyph below its box. */
  .lost__glyph span {
    line-height: 1;
  }

  .lost__glyph:active {
    cursor: grabbing;
  }

  .lost__glyph--1 {
    inset-inline-start: calc(50% - var(--glyph));
  }

  .lost__glyph--2 {
    inset-inline-start: 50%;
  }

  /* "drag me" sits above 子 with an arrow pointing down at the glyphs. */
  .lost__hint {
    position: absolute;
    inset-block-end: calc(var(--glyph) * 0.9);
    inset-inline-start: calc(50% + var(--glyph) * 0.7);
    display: grid;
    justify-items: start;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease);
  }

  .lost__hint[data-hidden] {
    opacity: 0;
  }

  .lost__arrow {
    inline-size: 40px;
    block-size: 40px;
    margin-inline-start: calc(-1 * var(--space-6));
    fill: none;
    stroke: currentcolor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  /* Motion allowed: glyphs start lifted and fall (the playground script). */
  @media (prefers-reduced-motion: no-preference) {
    .lost__glyph {
      transform: translateY(calc(var(--glyph) * -0.9));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lost__glyph {
      cursor: default;
    }

    .lost__hint {
      display: none;
    }
  }

  .lost__ground {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-8);
  }

  @media (width >= 48rem) {
    .lost__ground {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      padding-block: var(--space-8) var(--space-10);
    }
  }

  .lost__copy {
    display: grid;
    gap: var(--space-2);
  }

  .lost__label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .lost__title {
    font-size: clamp(var(--text-xl), 5vw, var(--text-3xl));
    letter-spacing: -0.02em;
    line-height: var(--leading-display);
  }

  .lost__lead {
    color: var(--muted);
    font-size: var(--text-md);
  }

  .lost__nav {
    display: grid;
    gap: var(--space-2);
  }

  .lost__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lost__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    font-weight: 500;
  }
</style>
