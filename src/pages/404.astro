---
import { getLocale, localizePath, useTranslations } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SECTIONS } from '../lib/nav';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const glyphs = ['迷', '子'];
---

<BaseLayout
  title={`${t('notFound.title')} · ${t('site.name')}`}
  description={t('notFound.metaDescription')}
  noindex
>
  <div class="lost">
    <div class="lost__field" data-lost-field>
      {glyphs.map((glyph, index) => (
        <button
          class:list={['lost__glyph', `lost__glyph--${index + 1}`]}
          type="button"
          aria-label={t('notFound.glyph', { glyph })}
          aria-describedby="lost-help"
          data-lost-glyph
        >
          <span lang="ja">{glyph}</span>
        </button>
      ))}
      <p class="lost__hint" aria-hidden="true" data-lost-hint>
        {t('notFound.hint')}
      </p>
    </div>
    <p class="visually-hidden" id="lost-help">
      {t('notFound.instructions')}
    </p>

    <div class="lost__text column">
      <p class="lost__kicker">404</p>
      <h1 class="lost__title">{t('notFound.title')}</h1>
      <p class="lost__lead">{t('notFound.lead')}</p>
      <nav aria-labelledby="lost-links">
        <h2 class="lost__links-title" id="lost-links">
          {t('notFound.links')}
        </h2>
        <ul class="lost__links">
          {SECTIONS.map((section) => (
            <li>
              <a href={localizePath(section.href, locale)}>{t(`nav.${section.id}`)}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</BaseLayout>

<script>
  import { initPlayground } from '../lib/lost/playground';

  const field = document.querySelector<HTMLElement>('[data-lost-field]');
  if (field && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    initPlayground(field);
  }
</script>

<style>
  .lost__field {
    --glyph: min(30vmin, 240px);

    position: relative;
    block-size: max(55vh, calc(var(--glyph) * 1.8 + 64px));
    overflow: hidden;
  }

  .lost__glyph {
    position: absolute;

    /* Keep in sync with FLOOR_GAP in lib/lost/playground.ts. */
    inset-block-end: 64px;
    display: grid;
    place-items: center;
    inline-size: var(--glyph);
    block-size: var(--glyph);
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-display-ja);
    font-size: calc(var(--glyph) * 0.9);
    font-weight: 700;
    line-height: 1;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .lost__glyph:active {
    cursor: grabbing;
  }

  .lost__glyph--1 {
    inset-inline-start: calc(50% - var(--glyph));
  }

  .lost__glyph--2 {
    inset-inline-start: 50%;
  }

  .lost__hint {
    position: absolute;
    inset-block-end: var(--space-4);
    inset-inline: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
    text-align: center;
    transition: opacity var(--duration-base) var(--ease);
  }

  .lost__hint[data-hidden] {
    opacity: 0;
  }

  /* Motion allowed: glyphs start lifted and fall (the playground script). */
  @media (prefers-reduced-motion: no-preference) {
    .lost__glyph {
      transform: translateY(calc(var(--glyph) * -0.6));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lost__glyph {
      cursor: default;
    }

    .lost__hint {
      display: none;
    }
  }

  .lost__text {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-10) 0;
  }

  .lost__kicker,
  .lost__links-title {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .lost__title {
    font-size: clamp(var(--text-2xl), 6vw, var(--text-3xl));
    letter-spacing: -0.02em;
    line-height: var(--leading-display);
  }

  .lost__lead {
    color: var(--muted);
    font-size: var(--text-md);
  }

  .lost__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .lost__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    font-weight: 500;
  }
</style>
