---
import CommunityRow from '../components/home/CommunityRow.astro';
import Hero from '../components/home/Hero.astro';
import IndexGrid from '../components/home/IndexGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteCopy } from '../lib/content/site';

const site = await getSiteCopy('en');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Nihongo No Torii',
  alternateName: '日本語の鳥居',
  url: new URL('/', Astro.site).href,
  inLanguage: 'en',
  description: site.description,
};
---

<BaseLayout title={site.title} description={site.description} jsonLd={jsonLd}>
  <div class="column">
    <Hero copy={site.hero} />
    <IndexGrid copy={site.index} />
    <CommunityRow video={site.video} discord={site.discord} social={site.social} />
  </div>
</BaseLayout>
