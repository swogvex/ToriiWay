---
/**
 * One page per kana (10-spec-learn: SEO): stroke order, examples, mnemonic and links to
 * the neighbours in table order. URLs keep the character: /learn/kana/か.
 */
import type { GetStaticPaths } from 'astro';

import JaText from '../../../components/content/JaText.astro';
import LearnToggle from '../../../components/learn/LearnToggle.astro';
import ListenButton from '../../../components/learn/ListenButton.astro';
import StrokeOrder from '../../../components/learn/StrokeOrder.astro';
import Button from '../../../components/ui/Button.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { DEFAULT_LOCALE, localizePath, useTranslations } from '../../../i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  getKana,
  type Kana,
  kanaHref,
  KANJIVG_CREDIT,
  panelKana,
  SCRIPTS,
  type Script,
  scriptHref,
  strokesLabel,
} from '../../../lib/kana/data';
import { breadcrumbList, jsonLdGraph } from '../../../lib/seo';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const script of SCRIPTS) {
    const items = await getKana(script);
    for (const [index, kana] of items.entries()) {
      paths.push({
        params: { char: kana.char },
        props: { script, kana, prev: items[index - 1], next: items[index + 1] },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  script: Script;
  kana: Kana;
  prev?: Kana | undefined;
  next?: Kana | undefined;
}

const { script, kana, prev, next } = Astro.props;
// Spanish kana pages arrive with the Spanish milestone.
const locale = DEFAULT_LOCALE;
const t = useTranslations(locale);
const site = Astro.site ?? new URL(Astro.url.origin);
const detail = panelKana(kana, script, locale);
const scriptName = t(`learn.${script}`);
const pageUrl = new URL(kanaHref(kana.char, locale), site);

const breadcrumb = [
  { label: t('nav.home'), href: localizePath('/', locale) },
  { label: t('learn.title'), href: localizePath('/learn', locale) },
  { label: scriptName, href: scriptHref(script, locale) },
  { label: kana.char },
];

const jsonLd = jsonLdGraph(
  {
    '@type': 'DefinedTerm',
    '@id': pageUrl.href,
    name: kana.char,
    alternateName: kana.romaji,
    description: detail.label,
    url: pageUrl.href,
    inLanguage: 'ja',
    inDefinedTermSet: new URL(scriptHref(script, locale), site).href,
  },
  breadcrumbList(breadcrumb, site, pageUrl),
);
---

<BaseLayout
  title={`${t('learn.kana.title', { char: kana.char, romaji: kana.romaji, script: scriptName.toLowerCase() })} · ${t('site.name')}`}
  description={t('learn.kana.description', {
    char: kana.char,
    romaji: kana.romaji,
    script: scriptName.toLowerCase(),
    strokes: strokesLabel(kana.strokes, locale),
  })}
  breadcrumb={breadcrumb}
  jsonLd={jsonLd}
  searchMeta={{ group: 'kana', title: `${kana.char} (${kana.romaji})` }}
>
  <article class="kana-page column" data-kana-page data-no-voice={t('learn.noVoice')}>
    <SectionHeader level="h1" kicker={detail.label} title={`${kana.char} ${kana.romaji}`}>
      <div class="kana-page__actions">
        <ListenButton text={kana.char} audio={kana.audio} />
        <LearnToggle char={kana.char} />
      </div>
    </SectionHeader>

    <div class="kana-page__body">
      <figure class="kana-page__strokes" data-kana-strokes>
        <div class="kana-page__glyph">
          <StrokeOrder glyph={detail.glyph} label={t('learn.strokeOrder', { char: kana.char })} />
        </div>
        <figcaption class="kana-page__credit">
          <a href={KANJIVG_CREDIT.url} rel="noopener" target="_blank">
            {t('learn.credit')}
            <span class="visually-hidden">{t('a11y.newTab')}</span>
          </a>
        </figcaption>
        <Button variant="outline" class="kana-page__replay" data-replay>
          {t('learn.replay')}
        </Button>
      </figure>

      <div class="kana-page__info">
        <section aria-labelledby="examples-title">
          <h2 class="kana-page__heading" id="examples-title">
            {t('learn.examples')}
          </h2>
          {detail.examples.length > 0 ? (
            <ul class="kana-page__examples">
              {detail.examples.map((example) => (
                <li>
                  <span class="kana-page__word" lang="ja">
                    {example.word}
                  </span>
                  <span>{example.reading}</span>
                  <span class="kana-page__meaning">{example.meaning}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="kana-page__muted">{t('learn.noExamples')}</p>
          )}
        </section>

        {detail.mnemonic && (
          <section aria-labelledby="mnemonic-title">
            <h2 class="kana-page__heading" id="mnemonic-title">
              {t('learn.mnemonic')}
            </h2>
            <p>
              <JaText text={detail.mnemonic} />
            </p>
          </section>
        )}
      </div>
    </div>

    <nav class="kana-page__nav" aria-label={t('learn.kanaNav')}>
      {prev ? (
        <a href={kanaHref(prev.char, locale)} rel="prev">
          <span class="kana-page__muted">{t('learn.prev')}</span>
          <span lang="ja">{prev.char}</span> {prev.romaji}
        </a>
      ) : (
        <span />
      )}
      <a href={scriptHref(script, locale)}>
        {t('learn.backToChart', { script: scriptName.toLowerCase() })}
      </a>
      {next ? (
        <a href={kanaHref(next.char, locale)} rel="next">
          <span class="kana-page__muted">{t('learn.next')}</span>
          <span lang="ja">{next.char}</span> {next.romaji}
        </a>
      ) : (
        <span />
      )}
    </nav>
  </article>
</BaseLayout>

<script>
  import { initLearned } from '../../../lib/kana/learned';
  import { initListen } from '../../../lib/kana/listen';
  import { playStrokes } from '../../../lib/kana/strokes';
  import { localKanaProgress } from '../../../lib/progress/kana';

  const page = document.querySelector<HTMLElement>('[data-kana-page]');
  if (page) {
    initLearned(page, localKanaProgress());
    void initListen(page);
  }

  const figure = document.querySelector('[data-kana-strokes]');
  const svg = figure?.querySelector<SVGSVGElement>('[data-strokes]');
  if (svg) {
    playStrokes(svg);
    figure?.querySelector('[data-replay]')?.addEventListener('click', () => playStrokes(svg));
  }
</script>

<style>
  .kana-page {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-16);
  }

  .kana-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block-start: var(--space-2);
  }

  .kana-page__body {
    display: grid;
    gap: var(--space-8);
  }

  @media (width >= 48rem) {
    .kana-page__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      padding-block-start: var(--space-2);
    }

    .kana-page__body {
      grid-template-columns: 280px minmax(0, 1fr);
      align-items: start;
    }
  }

  .kana-page__strokes {
    display: grid;
    gap: var(--space-3);
  }

  .kana-page__glyph {
    padding: var(--space-4);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .kana-page__credit {
    color: var(--muted);
    font-size: var(--text-2xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .kana-page__strokes :global(.kana-page__replay) {
      display: none;
    }
  }

  .kana-page__info {
    display: grid;
    gap: var(--space-8);
  }

  .kana-page__heading {
    margin-block-end: var(--space-3);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .kana-page__examples {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .kana-page__examples li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .kana-page__word {
    font-family: var(--font-body-ja);
    font-size: var(--text-lg);
  }

  .kana-page__meaning,
  .kana-page__muted {
    color: var(--muted);
  }

  .kana-page__nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    align-items: center;
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--line);
  }

  .kana-page__nav a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: baseline;
    min-block-size: var(--target-min);
    padding-block: var(--space-3);
  }

  .kana-page__nav a[rel='next'] {
    justify-self: end;
  }
</style>
