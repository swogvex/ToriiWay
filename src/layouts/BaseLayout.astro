---
/**
 * Site shell: skip link → rail → header (inside the column) → main → footer, plus the
 * search, shortcuts and mobile menu dialogs (07-spec-shell).
 */
import Footer from '../components/shell/Footer.astro';
import Head from '../components/shell/Head.astro';
import Header, { type Crumb } from '../components/shell/Header.astro';
import MobileMenu from '../components/shell/MobileMenu.astro';
import Rail from '../components/shell/Rail.astro';
import SearchDialog from '../components/shell/SearchDialog.astro';
import ShortcutsDialog from '../components/shell/ShortcutsDialog.astro';
import Toast from '../components/ui/Toast.astro';
import { getLocale, PUBLISHED_LOCALES, useTranslations } from '../i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumb?: Crumb[];
  jsonLd?: Record<string, unknown> | undefined;
  /** Path of the page this one duplicates; such a page stays out of the search index. */
  canonical?: string | undefined;
  /** Pagefind metadata for this page, e.g. { group: 'kana', title: 'Hiragana chart' }. */
  searchMeta?: Record<string, string>;
}

const { title, description, noindex, breadcrumb, jsonLd, canonical, searchMeta } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const searchable = !noindex && !canonical && PUBLISHED_LOCALES.includes(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <Head
      title={title}
      description={description}
      noindex={noindex}
      jsonLd={jsonLd}
      canonical={canonical}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('skip')}
    </a>
    <Rail />
    <div class="page">
      <Header breadcrumb={breadcrumb} />
      <main id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
        {/* One element per Pagefind meta: it reads a single "key:value" per attribute. */}
        {searchable &&
          Object.entries(searchMeta ?? {}).map(([key, value]) => (
            <span hidden data-pagefind-meta={`${key}:${value}`} />
          ))}
        <slot />
      </main>
      <Footer />
    </div>
    <SearchDialog />
    <ShortcutsDialog />
    <MobileMenu />
    <Toast />
  </body>
</html>

<script>
  import { initShell } from '../lib/shell';

  initShell();
</script>

<style>
  @media (width >= 64rem) {
    .page {
      padding-inline-start: var(--rail);
    }

    /*
     * The expanded rail sits in the empty gutter: the column only moves (just enough) when
     * the gutter is narrower than the rail. The extra space-4 covers the scrollbar in 100vw.
     */
    :global(:root[data-rail='expanded']) .page {
      padding-inline-start: clamp(
        var(--rail),
        2 * (var(--rail-expanded) + var(--space-4)) + var(--col) - 100vw,
        var(--rail-expanded)
      );
    }
  }
</style>
