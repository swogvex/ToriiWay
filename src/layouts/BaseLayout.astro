---
/**
 * Site shell: skip link → rail → header (inside the column) → main → footer, plus the
 * search, shortcuts and mobile menu dialogs (07-spec-shell).
 */
import Footer from '../components/shell/Footer.astro';
import Head from '../components/shell/Head.astro';
import Header, { type Crumb } from '../components/shell/Header.astro';
import MobileMenu from '../components/shell/MobileMenu.astro';
import Rail from '../components/shell/Rail.astro';
import SearchDialog from '../components/shell/SearchDialog.astro';
import ShortcutsDialog from '../components/shell/ShortcutsDialog.astro';
import Toast from '../components/ui/Toast.astro';
import { getLocale, useTranslations } from '../i18n';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumb?: Crumb[];
  jsonLd?: Record<string, unknown>;
}

const { title, description, noindex, breadcrumb, jsonLd } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <Head title={title} description={description} noindex={noindex} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('skip')}
    </a>
    <Rail />
    <div class="page">
      <Header breadcrumb={breadcrumb} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <SearchDialog />
    <ShortcutsDialog />
    <MobileMenu />
    <Toast />
  </body>
</html>

<script>
  import { initShell } from '../lib/shell';

  initShell();
</script>

<style>
  @media (width >= 64rem) {
    .page {
      padding-inline-start: var(--rail);
    }

    :global(:root[data-rail='expanded']) .page {
      padding-inline-start: var(--rail-expanded);
    }
  }
</style>
