---
import { brands, type BrandName } from './brands';

interface Props {
  name: BrandName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  class:list={['brand-icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  focusable="false"
  aria-hidden="true"
>
  <path d={brands[name]}></path>
</svg>

<style>
  .brand-icon {
    flex: none;
  }
</style>
