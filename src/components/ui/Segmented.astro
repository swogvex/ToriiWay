---
/**
 * Native radio group: the browser provides radiogroup semantics and arrow-key navigation.
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  legend: string;
  options: Option[];
  value?: string;
  class?: string;
}

const { name, legend, options, value = options[0]?.value, class: className } = Astro.props;
---

<fieldset class:list={['segmented', className]}>
  <legend class="segmented__legend">{legend}</legend>
  <div class="segmented__track">
    {options.map((option) => (
      // The label text is in .segmented__text, one level deeper than the rule looks.
      // eslint-disable-next-line astro/jsx-a11y/label-has-associated-control
      <label class="segmented__option">
        <input
          class="segmented__input"
          type="radio"
          name={name}
          value={option.value}
          checked={option.value === value}
        />
        <span class="segmented__label" data-text={option.label}>
          <span class="segmented__text">{option.label}</span>
        </span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .segmented {
    min-inline-size: 0;
    padding: 0;
    border: 0;
  }

  .segmented__legend {
    margin-block-end: var(--space-2);
    padding: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .segmented__track {
    display: inline-flex;
    gap: var(--space-1);
    padding: var(--space-1);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
  }

  .segmented__option {
    position: relative;
  }

  .segmented__input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .segmented__label {
    display: grid;
    place-items: center;
    min-block-size: 36px;
    padding-inline: var(--space-4);
    border-radius: calc(var(--radius-control) - 2px);
    color: var(--muted);
    font-weight: 500;
    pointer-events: none;
  }

  /*
   * An invisible bold copy reserves the selected width, so choosing an option never
   * changes the group's width (or pushes the next group onto another line). The text and
   * its bold copy share the one grid cell: without an explicit cell the text was
   * auto-placed into a second row and sat 3–6px below the centre.
   */
  .segmented__text,
  .segmented__label::after {
    grid-area: 1 / 1;
  }

  .segmented__label::after {
    content: attr(data-text);
    overflow: hidden;
    block-size: 0;
    font-weight: 700;
    visibility: hidden;
  }

  .segmented__input:hover + .segmented__label {
    color: var(--ink);
  }

  /* Selected: filled ink plus bold weight, so color is not the only cue. */
  .segmented__input:checked + .segmented__label {
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
  }

  .segmented__input:focus-visible + .segmented__label {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Small phones: longer labels (Spanish "Fácil · Normal · Difícil · Extremo") must fit 360px. */
  @media (width < 26rem) {
    .segmented__label {
      padding-inline: var(--space-3);
    }
  }
</style>
