---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  name?: string;
  as?: 'input' | 'select' | 'textarea';
  type?: 'text' | 'email' | 'search' | 'number' | 'url';
  hint?: string;
  error?: string;
  options?: Option[];
  value?: string;
  placeholder?: string;
  required?: boolean;
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  class?: string;
}

const {
  id,
  label,
  name = id,
  as = 'input',
  type = 'text',
  hint,
  error,
  options = [],
  value,
  placeholder,
  required = false,
  autocomplete,
  class: className,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const control = {
  id,
  name,
  class: 'field__control',
  required,
  autocomplete,
  'aria-describedby': [hintId, errorId].filter(Boolean).join(' ') || undefined,
  'aria-invalid': error ? ('true' as const) : undefined,
};
---

<div class:list={['field', error && 'field--error', className]}>
  <label class="field__label" for={id}>
    {label}
    {required && <span aria-hidden="true">*</span>}
  </label>
  {hint && (
    <p class="field__hint" id={hintId}>
      {hint}
    </p>
  )}
  {as === 'select' ? (
    <select {...control}>
      {options.map((option) => (
        <option value={option.value} selected={option.value === value}>
          {option.label}
        </option>
      ))}
    </select>
  ) : as === 'textarea' ? (
    <textarea {...control} placeholder={placeholder} rows="4" set:text={value ?? ''} />
  ) : (
    <input {...control} type={type} value={value} placeholder={placeholder} />
  )}
  {error && (
    <p class="field__error" id={errorId}>
      <Icon name="triangle-alert" size={16} />
      {error}
    </p>
  )}
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
  }

  .field__label {
    font-weight: 500;
  }

  .field__hint {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .field__control {
    inline-size: 100%;
    min-block-size: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
  }

  textarea.field__control {
    resize: vertical;
  }

  .field__control::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .field__control:hover {
    border-color: var(--muted);
  }

  /* Error: dashed accent border plus icon and message, never color alone. */
  .field--error .field__control {
    border-style: dashed;
    border-color: var(--accent-ink);
  }

  .field__error {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent-ink);
    font-size: var(--text-sm);
  }
</style>
