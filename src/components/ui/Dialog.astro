---
/**
 * Native modal <dialog>: showModal() makes the page inert and Esc closes it.
 * Open it with any button carrying data-dialog-open="<id>"; focus returns to that button.
 */
import IconButton from './IconButton.astro';

interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className } = Astro.props;
---

<dialog class:list={['dialog', className]} id={id} aria-labelledby={`${id}-title`}>
  <header class="dialog__header">
    <h2 class="dialog__title" id={`${id}-title`}>
      {title}
    </h2>
    <form method="dialog">
      <IconButton icon="x" label="Close" size={40} type="submit" />
    </form>
  </header>
  <div class="dialog__body">
    <slot />
  </div>
  {Astro.slots.has('footer') && (
    <footer class="dialog__footer">
      <slot name="footer" />
    </footer>
  )}
</dialog>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;

    const opener = target?.closest<HTMLElement>('[data-dialog-open]');
    if (opener) {
      const dialog = document.getElementById(opener.dataset.dialogOpen ?? '');
      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
        dialog.addEventListener('close', () => opener.focus(), { once: true });
      }
      return;
    }

    // A click on the backdrop lands on the <dialog> element itself.
    if (target instanceof HTMLDialogElement && target.classList.contains('dialog')) {
      target.close();
    }
  });
</script>

<style>
  .dialog {
    overscroll-behavior: contain;
    inline-size: min(560px, calc(100vw - 2 * var(--space-4)));
    max-block-size: calc(100dvh - 2 * var(--space-8));
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-modal);
    color: var(--ink);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity var(--duration-base) var(--ease),
      transform var(--duration-base) var(--ease),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }

  .dialog[open] {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .dialog[open] {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .dialog::backdrop {
    background: rgb(0 0 0 / 50%);
  }

  .dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-6);
    border-block-end: 1px solid var(--line);
  }

  .dialog__title {
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .dialog__body {
    padding: var(--space-6);
  }

  .dialog__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-block-start: 1px solid var(--line);
  }
</style>
