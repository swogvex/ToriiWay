---
/**
 * JLPT start page (artboard 11). The level switch, its section list and the start card
 * follow the checked level with CSS only; src/lib/jlpt/start.ts adds the tips dialog,
 * starts the run on the server and tests the Japanese voice.
 */
import { getLocale, localizePath, useTranslations } from '../../i18n';
import testAudio from '../../data/jlpt/test-audio.json';
import { JLPT_LEVELS, LEVELS, totalMinutes } from '../../lib/jlpt/levels';
import type { JlptLevel } from '../../lib/jlpt/types';
import VoiceHelpDialog from '../audio/VoiceHelpDialog.astro';
import VoiceHelpLink from '../audio/VoiceHelpLink.astro';
import Button from '../ui/Button.astro';
import Dialog from '../ui/Dialog.astro';
import Field from '../ui/Field.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Segmented from '../ui/Segmented.astro';

interface Props {
  /** Levels whose question bank can build a full paper. */
  available: JlptLevel[];
}

const { available } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const label = (level: JlptLevel) => (level === 'kana' ? t('jlpt.level.kana') : level);
const mark = (level: JlptLevel) => (level === 'kana' ? 'かな' : level);
const initial: JlptLevel = 'N5';
const messages = {
  pass: t('jlpt.recent.pass'),
  notYet: t('jlpt.recent.notYet'),
  starting: t('jlpt.start.starting'),
  limit: t('jlpt.start.error.limit'),
  unavailable: t('jlpt.start.error.unavailable'),
  generic: t('jlpt.start.error.generic'),
  noVoice: t('jlpt.testAudio.none'),
  phrase: t('jlpt.testAudio.phrase'),
  levels: Object.fromEntries(JLPT_LEVELS.map((level) => [level, label(level)])),
};
---

<div
  class="start column"
  data-jlpt-start
  data-available={JSON.stringify(available)}
  data-messages={JSON.stringify(messages)}
  data-run-url={localizePath('/jlpt/run', locale)}
>
  <p class="start__mark" aria-hidden="true">
    {JLPT_LEVELS.map((level) => (
      <span data-for={level}>{mark(level)}</span>
    ))}
  </p>

  <SectionHeader level="h1" kicker={t('jlpt.kicker')} title={t('jlpt.title')}>
    <p class="start__lead">{t('jlpt.lead')}</p>
  </SectionHeader>

  <p class="start__resume" data-resume hidden>
    <Icon name="clock" size={20} />
    <span data-resume-text data-template={t('jlpt.resume.text')}></span>
    <a href={localizePath('/jlpt/run', locale)}>{t('jlpt.resume.link')}</a>
  </p>

  <div class="start__grid">
    <div class="start__main">
      <Segmented
        name="level"
        legend={t('jlpt.levels')}
        value={initial}
        class="start__levels"
        options={JLPT_LEVELS.map((level) => ({ value: level, label: label(level) }))}
      />

      {JLPT_LEVELS.map((level) => (
        <section class="start__panel" data-for={level} aria-labelledby={`jlpt-sections-${level}`}>
          <h2 class="start__label" id={`jlpt-sections-${level}`}>
            {t('jlpt.sections', { level: label(level) })}
          </h2>
          <ol class="sections">
            {LEVELS[level].sections.map((section, index) => (
              <li class="sections__row">
                <span class="sections__name">
                  <strong>
                    {index + 1} · {t(`jlpt.section.${section.id}`)}
                  </strong>
                  <span class="sections__ja" lang="ja">
                    {section.ja}
                  </span>
                </span>
                <span class="sections__time">
                  {t('jlpt.minutes', { minutes: section.minutes })}
                </span>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <h2 class="visually-hidden">{t('jlpt.rules')}</h2>
      <ol class="rules">
        <li>{t('jlpt.rule.1')}</li>
        <li>{t('jlpt.rule.2')}</li>
        <li>{t('jlpt.rule.3')}</li>
        <li>
          {t('jlpt.rule.4')}
          <button type="button" class="rules__audio" data-test-audio data-src={testAudio.url}>
            {t('jlpt.testAudio')}
          </button>
          <span class="rules__note" data-audio-note role="status"></span>
          <span class="rules__help" data-voice-help-link hidden>
            <VoiceHelpLink />
          </span>
        </li>
        <li class="rules__kana" data-for="kana">
          {t('jlpt.rule.kana')}
        </li>
      </ol>
    </div>

    <div class="start__side">
      <form class="card" data-start-form novalidate>
        <p class="start__label">
          {JLPT_LEVELS.map((level) => (
            <span data-for={level}>
              {t('jlpt.start.kicker', { level: label(level), minutes: totalMinutes(level) })}
            </span>
          ))}
        </p>
        <Field
          id="jlpt-email"
          name="email"
          type="email"
          label={t('jlpt.start.email')}
          hint={t('jlpt.start.emailHint')}
          placeholder="you@example.com"
          autocomplete="email"
        />
        <label class="card__check">
          <input type="checkbox" name="public" />
          <span>{t('jlpt.start.public')}</span>
        </label>
        <Button variant="accent" size={52} type="submit" class="card__go" data-start-button>
          {JLPT_LEVELS.map((level) => (
            <span data-for={level}>{t('jlpt.start.button', { level: label(level) })}</span>
          ))}
          <Icon name="arrow-right" size={20} />
        </Button>
        {JLPT_LEVELS.filter((level) => !available.includes(level)).map((level) => (
          <p class="card__note" data-for={level}>
            {t('jlpt.start.soon', { level: label(level) })}
          </p>
        ))}
        <p class="card__error" role="alert" data-start-error></p>
        <noscript>
          <p class="card__note">{t('jlpt.start.noscript')}</p>
        </noscript>
        <p class="card__note card__mobile">{t('jlpt.start.mobile')}</p>
      </form>
      <section class="recent" aria-labelledby="jlpt-recent" data-recent hidden>
        <h2 class="start__label" id="jlpt-recent">
          {t('jlpt.recent.title')}
        </h2>
        <ol class="recent__list" data-recent-list></ol>
      </section>
    </div>
  </div>

  <p class="start__disclaimer">{t('jlpt.disclaimer')}</p>
</div>

<VoiceHelpDialog />

<Dialog id="jlpt-tips" title={t('jlpt.tips.title')}>
  <ol class="tips">
    {([1, 2, 3, 4] as const).map((number) => (
      <li>
        <strong>{t(`jlpt.tips.${number}.title`)}</strong>
        <span>{t(`jlpt.tips.${number}.text`)}</span>
      </li>
    ))}
  </ol>
  <div slot="footer" class="tips__actions">
    <form method="dialog">
      <Button variant="outline" type="submit">
        {t('jlpt.tips.cancel')}
      </Button>
    </form>
    <Button variant="accent" data-tips-go>
      {t('jlpt.tips.go')}
      <Icon name="arrow-right" size={20} />
    </Button>
  </div>
</Dialog>

<script>
  import { initStart } from '../../lib/jlpt/start';

  const root = document.querySelector<HTMLElement>('[data-jlpt-start]');
  if (root) initStart(root);
</script>

<style>
  .start {
    position: relative;
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-10) var(--space-16);
  }

  /* Big outlined level behind the header, like the area glyph on other pages. */
  .start__mark {
    position: absolute;
    inset-block-start: var(--space-4);
    inset-inline-end: 0;
    z-index: -1;
    color: var(--line);
    font-size: clamp(6rem, 22vw, 15rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    pointer-events: none;
    user-select: none;
  }

  .start__lead {
    max-inline-size: 52ch;
    color: var(--muted);
    font-size: var(--text-md);
  }

  .start__resume {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--info-soft);
    border-radius: var(--radius-control);
  }

  .start__resume[hidden] {
    display: none;
  }

  .start__resume a {
    font-weight: 700;
  }

  .start__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (width >= 60rem) {
    .start__grid {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }
  }

  .start__main {
    display: grid;
    gap: var(--space-6);
  }

  /* One tab per level across the column (artboard 11): same width, narrower cells. */
  .start :global(.start__levels .segmented__track) {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    inline-size: 100%;
  }

  .start :global(.start__levels .segmented__label) {
    min-block-size: 52px;
    padding-inline: var(--space-1);

    /* Six cells must fit "Kana" on a 320 px phone. */
    font-size: clamp(var(--text-sm), 4.2vw, var(--text-md));
    font-weight: 700;
  }

  .start__label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .sections,
  .rules {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .sections {
    display: grid;
    margin-block-start: var(--space-3);
    border-block-start: 1px solid var(--line);
  }

  .sections__row {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--line);
  }

  .sections__name {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    align-items: baseline;
  }

  .sections__ja {
    color: var(--muted);
    font-family: var(--font-body-ja);
  }

  .sections__time {
    flex: none;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .rules {
    display: grid;
    gap: var(--space-3);
    counter-reset: rule;
  }

  .rules li {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    counter-increment: rule;
  }

  .rules li::before {
    grid-row: span 2;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    content: counter(rule, decimal-leading-zero);
  }

  .rules__audio {
    justify-self: start;
    padding: 0;
    color: var(--accent-ink);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .rules__note {
    grid-column: 2;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .rules__note:empty,
  .rules__help[hidden] {
    display: none;
  }

  .rules__help {
    grid-column: 2;
    font-size: var(--text-sm);
  }

  .start__side {
    display: grid;
    gap: var(--space-8);
    align-content: start;
  }

  .recent {
    display: grid;
    gap: var(--space-3);
  }

  .recent[hidden] {
    display: none;
  }

  .recent__list {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .recent__list :global(li) {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-control);
  }

  .recent__list :global(.recent__date) {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .recent__list :global(.recent__badge) {
    flex: none;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-chip);
  }

  .recent__list :global(.recent__badge[data-passed]) {
    color: var(--info);
    background: var(--info-soft);
    border-color: transparent;
  }

  .card {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
  }

  .card__check {
    display: flex;
    gap: var(--space-3);
    align-items: start;
    cursor: pointer;
  }

  .card__check input {
    flex: none;
    inline-size: 20px;
    block-size: 20px;
    margin: 2px 0 0;
    accent-color: var(--ink);
  }

  .card__go {
    inline-size: 100%;
  }

  .card__note {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .card__error {
    color: var(--accent-ink);
    font-size: var(--text-sm);
  }

  .card__error:empty {
    display: none;
  }

  @media (width >= 48rem) {
    .card__mobile {
      display: none;
    }
  }

  .start__disclaimer {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Everything marked data-for shows only for the checked level. */
  .start [data-for] {
    display: none;
  }

  .start:has(:global(input[name='level'][value='kana']:checked)) [data-for='kana'],
  .start:has(:global(input[name='level'][value='N5']:checked)) [data-for='N5'],
  .start:has(:global(input[name='level'][value='N4']:checked)) [data-for='N4'],
  .start:has(:global(input[name='level'][value='N3']:checked)) [data-for='N3'],
  .start:has(:global(input[name='level'][value='N2']:checked)) [data-for='N2'],
  .start:has(:global(input[name='level'][value='N1']:checked)) [data-for='N1'] {
    display: revert;
  }

  .start:has(:global(input[name='level'][value='kana']:checked)) .rules__kana {
    display: grid;
  }

  .tips {
    display: grid;
    gap: var(--space-4);
  }

  .tips li {
    display: grid;
    gap: var(--space-1);
  }

  .tips span {
    color: var(--muted);
  }

  .tips__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: end;
  }
</style>
