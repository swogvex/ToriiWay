---
/**
 * The score report card (artboard 14): structure inspired by the official report, never
 * a copy, always marked as a simulation.
 */
import { getLocale, useTranslations } from '../../i18n';
import { LEVELS } from '../../lib/jlpt/levels';
import type { ScoreReport } from '../../lib/jlpt/scoring';
import type { JlptLevel } from '../../lib/jlpt/types';

interface Props {
  level: JlptLevel;
  name: string | null;
  date: string;
  scores: ScoreReport;
  percentile: number | null;
  correct: number;
  total: number;
  url: string;
}

const { level, name, date, scores, percentile, correct, total, url } = Astro.props;
const t = useTranslations(getLocale(Astro.url.pathname));
const config = LEVELS[level];
const levelLabel = level === 'kana' ? t('jlpt.level.kana') : level;
const gradeJa = { vocabulary: '文字・語彙', grammar: '文法', reading: '読解' } as const;
const grades = config.referenceGrades.filter(
  (area): area is keyof typeof gradeJa => area in gradeJa && Boolean(scores.grades[area]),
);
const check = (passed: boolean) => (passed ? '✓' : '✗');
---

<article class="report" aria-labelledby="report-title" data-watermark={t('jlpt.report.watermark')}>
  <header class="report__band">
    <div>
      <h2 class="report__title" id="report-title" lang="ja">
        {t('jlpt.report.band')}
      </h2>
      <p class="report__sub">{t('jlpt.report.bandSub')}</p>
    </div>
    <p class="report__notice" lang="ja">
      {t('jlpt.report.notice')}
    </p>
  </header>

  <dl class="report__meta">
    <div>
      <dt>
        {t('jlpt.report.level')} <span lang="ja">レベル</span>
      </dt>
      <dd class="report__level">{levelLabel}</dd>
    </div>
    <div>
      <dt>
        {t('jlpt.report.name')} <span lang="ja">氏名</span>
      </dt>
      <dd class="report__mono">{name ?? t('jlpt.report.noName')}</dd>
    </div>
    <div>
      <dt>
        {t('jlpt.report.date')} <span lang="ja">受験日</span>
      </dt>
      <dd class="report__mono">{date}</dd>
    </div>
  </dl>

  <div class:list={['report__result', { 'report__result--pass': scores.passed }]}>
    <p class="report__label">
      {t('jlpt.report.result')} <span lang="ja">合否</span>
    </p>
    <p class="report__verdict">
      <span lang="ja">{scores.passed ? '合格' : '不合格'}</span>
      {scores.passed ? t('jlpt.report.passed') : t('jlpt.report.notYet')}
    </p>
    <p class="report__mono">
      {t('jlpt.report.passMark', { mark: scores.passMark, max: scores.max })}
    </p>
  </div>

  <section class="report__section" aria-labelledby="report-scaled">
    <h3 class="report__label" id="report-scaled">
      {t('jlpt.report.scaled')} <span lang="ja">得点区分別得点</span>
    </h3>
    <div class="report__scroll">
      <table class="scores">
        <thead>
          <tr>
            {scores.sections.map((section) => (
              <th scope="col">
                <span lang="ja">{config.scoring.find((entry) => entry.id === section.id)?.ja}</span>
                {t(`jlpt.done.scoring.${section.id}`)}
              </th>
            ))}
            <th scope="col" class="scores__total">
              <span lang="ja">総合得点</span>
              {t('jlpt.report.total')}
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            {scores.sections.map((section) => (
              <td class="scores__value">
                <strong>{section.scaled}</strong> / {section.max}
              </td>
            ))}
            <td class="scores__value scores__total">
              <strong>{scores.total}</strong> / {scores.max}
            </td>
          </tr>
          <tr>
            {scores.sections.map((section) => (
              <td class="scores__min">
                {t('jlpt.report.minimum', { min: section.min })} {check(section.passed)}
                <span class="visually-hidden">
                  {section.passed ? t('jlpt.report.met') : t('jlpt.report.missed')}
                </span>
              </td>
            ))}
            <td class="scores__min scores__total">
              {`${t('jlpt.report.pass', { mark: scores.passMark })} ${check(scores.total >= scores.passMark)}`}
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="report__section report__reference" aria-labelledby="report-reference">
    <h3 class="report__label" id="report-reference">
      {t('jlpt.report.reference')} <span lang="ja">参考情報</span>
    </h3>
    {grades.length > 0 && (
      <div class="report__grades">
        <dl class="grades">
          {grades.map((area) => (
            <div>
              <dt>
                <span lang="ja">{gradeJa[area]}</span>
                {t(`jlpt.report.grade.${area}`)}
              </dt>
              <dd>{scores.grades[area]}</dd>
            </div>
          ))}
        </dl>
        <p class="report__legend">{t('jlpt.report.gradeLegend')}</p>
      </div>
    )}
    <dl class="report__cards">
      <div class="report__card">
        <dt>{t('jlpt.report.percentile')}</dt>
        <dd class:list={{ 'report__card--soon': percentile === null }}>
          {percentile ?? t('jlpt.report.percentileSoon')}
        </dd>
      </div>
      <div class="report__card">
        <dt>{t('jlpt.report.correct')}</dt>
        <dd>
          {correct} / {total}
        </dd>
      </div>
    </dl>
  </section>

  <footer class="report__footer">
    <p>{t('jlpt.report.footer')}</p>
    <p>{url}</p>
  </footer>
</article>

<style>
  .report {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: var(--radius-card);
  }

  /* Decorative watermark as generated content: not read aloud, not text for axe. */
  .report::before {
    position: absolute;
    content: attr(data-watermark);
    inset-block-start: 45%;
    inset-inline-start: 50%;
    color: var(--accent);
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    white-space: nowrap;
    opacity: 0.08;
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(-18deg);
  }

  .report__band {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6) var(--space-8);
    color: var(--bg);
    background: var(--ink);
  }

  .report__title {
    font-family: var(--font-display-ja);
    font-size: var(--text-xl);
  }

  .report__sub,
  .report__mono,
  .report__footer {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .report__notice {
    font-family: var(--font-body-ja);
    font-size: var(--text-sm);
  }

  .report__meta {
    display: grid;
    grid-template-columns: auto 1fr auto;
    border-block-end: 1px solid var(--line-strong);
  }

  .report__meta > div {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-5) var(--space-8);
  }

  .report__meta > div + div {
    border-inline-start: 1px solid var(--line-strong);
  }

  .report__meta dt,
  .report__label,
  .report__card dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .report__level {
    font-size: var(--text-2xl);
    font-weight: 700;
  }

  .report__meta .report__mono {
    font-size: var(--text-lg);
  }

  .report__result {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6) var(--space-8);
    color: var(--ink);
    background: var(--bg);
    border-block-end: 1px solid var(--line-strong);
  }

  .report__result--pass {
    color: var(--info);
    background: var(--info-soft);
  }

  .report__result .report__label {
    color: inherit;
  }

  .report__verdict {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
  }

  .report__verdict span {
    font-family: var(--font-display-ja);
    font-size: var(--text-3xl);
  }

  .report__section {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
  }

  .report__section + .report__section {
    border-block-start: 1px solid var(--line-strong);
  }

  .report__scroll {
    overflow-x: auto;
  }

  .scores {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .scores th,
  .scores td {
    padding: var(--space-3) var(--space-4);
    text-align: center;
    border: 1px solid var(--line-strong);
  }

  .scores th {
    color: var(--muted);
    font-weight: 400;
  }

  .scores th span {
    display: block;
    font-family: var(--font-body-ja);
    font-size: var(--text-sm);
  }

  .scores__value {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .scores__value strong {
    color: var(--ink);
    font-size: var(--text-3xl);
  }

  .scores__min {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .scores .scores__total {
    background: var(--bg);
  }

  .report__reference {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (width >= 48rem) {
    .report__reference {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }

    .report__reference > .report__label {
      grid-column: 1 / -1;
    }
  }

  .report__grades {
    display: grid;
    gap: var(--space-3);
  }

  .grades {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
  }

  .grades > div + div {
    border-inline-start: 1px solid var(--line-strong);
  }

  .grades dt {
    padding: var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
    border-block-end: 1px solid var(--line-strong);
  }

  .grades dt span {
    display: block;
    font-family: var(--font-body-ja);
  }

  .grades dd {
    padding: var(--space-4);
    font-size: var(--text-2xl);
    font-weight: 700;
    text-align: center;
  }

  .report__legend {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .report__cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-4);
  }

  .report__card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
  }

  .report__card dd {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
  }

  .report__card dd.report__card--soon {
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .report__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    padding: var(--space-4) var(--space-8);
    color: var(--muted);
    border-block-start: 1px solid var(--line-strong);
  }

  @media (width < 40rem) {
    .report__band,
    .report__result,
    .report__section,
    .report__footer,
    .report__meta > div {
      padding-inline: var(--space-4);
    }

    .report__meta {
      grid-template-columns: 1fr;
    }

    .report__meta > div + div {
      border-inline-start: 0;
      border-block-start: 1px solid var(--line-strong);
    }
  }
</style>
