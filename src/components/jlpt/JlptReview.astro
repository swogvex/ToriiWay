---
/** Wrong and unanswered questions with the correct choice and the explanation. */
import { getLocale, useTranslations } from '../../i18n';
import { parseScript, parseStem } from '../../lib/jlpt/exam/format';
import type { ReviewItem } from '../../lib/jlpt/report';

interface Props {
  items: ReviewItem[];
}

const { items } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const speaker = { narrator: '', man: '男：', woman: '女：' } as const;
// One collapsible group per section keeps long reviews short; all start closed (owner choice).
const groups = [...new Set(items.map((item) => item.section))].map((section) => ({
  section,
  items: items.filter((item) => item.section === section),
}));
---

<section class="review" id="review" aria-labelledby="review-title" tabindex="-1">
  <h2 id="review-title">{t('jlpt.report.review')}</h2>
  {items.length === 0 && <p>{t('jlpt.report.review.none')}</p>}
  {groups.map((group) => (
    <details class="review__group">
      <summary>
        {t(`jlpt.section.${group.section}`)}
        <span class="review__count">
          {t('jlpt.report.review.count', { count: group.items.length })}
        </span>
      </summary>
      <ol class="review__list">
        {group.items.map((item) => (
          <li class="mistake">
            <p class="mistake__where">
              {t('jlpt.report.review.question', {
                section: t(`jlpt.section.${item.section}`),
                number: item.number,
              })}
              <span lang="ja"> · もんだい{item.mondai}</span>
            </p>
            <p class="mistake__instruction">{item.instruction[locale] ?? item.instruction.en}</p>
            {item.passage && (
              <p class="mistake__passage" lang="ja">
                {item.passage}
              </p>
            )}
            <p class="mistake__stem" lang="ja">
              {parseStem(item.stem).map((part) =>
                part.mark === 'underline' ? <u>{part.text}</u> : part.text,
              )}
            </p>
            <dl class="mistake__answers">
              <div class="mistake__yours">
                <dt>{t('jlpt.report.review.yours')}</dt>
                <dd lang={item.choice ? 'ja' : undefined}>
                  {item.choice
                    ? `${item.choice}. ${item.choices[item.choice - 1] ?? ''}`
                    : t('jlpt.report.review.unanswered')}
                </dd>
              </div>
              <div class="mistake__correct">
                <dt>{t('jlpt.report.review.correct')}</dt>
                <dd lang="ja">
                  {item.answer}. {item.choices[item.answer - 1]}
                </dd>
              </div>
            </dl>
            <p class="mistake__why">{item.explanation[locale]}</p>
            {item.transcript && (
              <details class="mistake__transcript">
                <summary>{t('jlpt.report.review.transcript')}</summary>
                <p lang="ja">
                  {parseScript(item.transcript).map((line) => (
                    <span>
                      {speaker[line.role]}
                      {line.text}
                    </span>
                  ))}
                </p>
              </details>
            )}
          </li>
        ))}
      </ol>
    </details>
  ))}
</section>

<style>
  .review {
    display: grid;
    gap: var(--space-6);
  }

  .review:focus {
    outline: none;
  }

  .review h2 {
    font-size: var(--text-2xl);
  }

  .review__group {
    border-block-start: 1px solid var(--line-strong);
  }

  .review__group > summary {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    font-size: var(--text-lg);
    font-weight: 700;
    cursor: pointer;
  }

  /* Flex hides the native marker; groups start closed, so show that they open. */
  .review__group > summary::after {
    align-self: center;
    inline-size: 0.5em;
    block-size: 0.5em;
    margin-inline: auto 0.25em;
    content: '';
    border-block-end: 2px solid currentcolor;
    border-inline-end: 2px solid currentcolor;
    transform: rotate(45deg);
  }

  .review__group[open] > summary::after {
    transform: rotate(-135deg);
  }

  .review__count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .review__list {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin: 0 0 var(--space-6);
    list-style: none;
  }

  .mistake {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
  }

  .mistake__where {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .mistake__instruction {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .mistake__passage {
    padding: var(--space-4);
    font-family: var(--font-body-ja);
    line-height: var(--leading-ja);
    white-space: pre-line;
    background: var(--bg);
    border-radius: var(--radius-control);
  }

  .mistake__stem {
    font-family: var(--font-body-ja);
    font-size: var(--text-lg);
    line-height: var(--leading-ja);
    white-space: pre-line;
  }

  .mistake__stem u {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .mistake__answers {
    display: grid;
    gap: var(--space-3);
  }

  @media (width >= 48rem) {
    .mistake__answers {
      grid-template-columns: 1fr 1fr;
    }
  }

  .mistake__answers > div {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-control);
  }

  .mistake__answers dt {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
  }

  .mistake__answers dd {
    font-family: var(--font-body-ja);
    font-size: var(--text-md);
  }

  .mistake__yours {
    color: var(--accent-ink);
    background: var(--accent-soft);
  }

  .mistake__correct {
    color: var(--info);
    background: var(--info-soft);
  }

  .mistake__transcript summary {
    color: var(--muted);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .mistake__transcript p {
    display: grid;
    gap: var(--space-1);
    margin-block-start: var(--space-2);
    font-family: var(--font-body-ja);
  }
</style>
