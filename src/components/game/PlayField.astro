---
/**
 * Kana Rush stage: the field with its bubbles (cloned from the template by
 * src/game/field.ts), the overlay panels (countdown, pause, endings) and the input
 * line. The field is decorative for screen readers: the game is not screen-reader
 * playable (see the accessibility statement).
 */
import { getLocale, localizePath, useTranslations } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const setupHref = localizePath('/game', locale);
const endings = [
  ['cleared', t('game.play.cleared')],
  ['failed', t('game.play.failed')],
  ['quit', t('game.play.quit')],
] as const;
---

<div class="stage">
  <div class="field" data-field aria-hidden="true">
    <template data-bubble-template>
      <div class="bubble" hidden>
        <span class="bubble__pill">
          <span class="bubble__text" lang="ja" data-text></span>
          <span class="bubble__mark">!</span>
        </span>
        <Icon name="arrow-right" size={18} class="bubble__arrow" />
        <span class="bubble__hint" data-hint></span>
      </div>
    </template>
  </div>
  <div class="stage__damage" data-damage aria-hidden="true"></div>
  <p class="stage__level" data-level-toast aria-hidden="true"></p>

  <div class="stage__overlay" data-overlay>
    <div class="stage__panel" data-panel="loading">
      <p>{t('game.play.loading')}</p>
    </div>
    <div class="stage__panel" data-panel="countdown" hidden>
      <p class="stage__count" lang="ja" aria-hidden="true" data-count></p>
      <p class="stage__intro">{t('game.play.intro')}</p>
    </div>
    <div class="stage__panel" data-panel="paused" hidden>
      <p class="stage__title" role="status">
        {t('game.paused')}
      </p>
      <div class="stage__actions">
        <Button data-resume>{t('game.resume')}</Button>
        <Button variant="outline" data-quit>
          {t('game.quitRun')}
        </Button>
      </div>
    </div>
    <div class="stage__panel" data-panel="unavailable" hidden>
      <p>{t('game.play.unavailable')}</p>
      <Button variant="outline" href={setupHref}>
        {t('game.play.change')}
      </Button>
    </div>
    {endings.map(([status, title]) => (
      <div class="stage__panel" data-panel={status} hidden>
        <p class="stage__title" role="status">
          {title}
        </p>
        <p class="stage__best" data-new-best hidden>
          <Icon name="check" size={16} />
          {t('game.play.newBest')}
        </p>
        <div class="stage__actions">
          <Button variant="outline" href={setupHref}>
            {t('game.play.change')}
          </Button>
          <Button data-restart>{t('game.play.again')}</Button>
        </div>
      </div>
    ))}
  </div>
</div>

<label class="entry" for="play-input">
  <span class="entry__label">{t('game.play.input')}</span>
  <span class="entry__typed" aria-hidden="true">
    <span data-typed></span>
    <span class="entry__wrong" data-wrong></span>
  </span>
  <span class="entry__kana" lang="ja" aria-hidden="true" data-typed-kana></span>
  <input
    id="play-input"
    class="visually-hidden"
    type="text"
    autocomplete="off"
    autocapitalize="off"
    autocorrect="off"
    spellcheck="false"
    aria-label={t('game.play.inputLabel')}
    data-input
  />
</label>
<p class="entry__focus" data-focus-note hidden>
  {t('game.play.focus')}
</p>

<style>
  .stage {
    position: relative;
  }

  .field {
    position: relative;
    overflow: hidden;
    inline-size: 100%;
    max-block-size: min(440px, 48svh);
    aspect-ratio: 1000 / 440;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-inline-width: 3px;
    border-radius: var(--radius-card);
    transition: filter var(--duration-base) var(--ease);
  }

  .stage.is-paused .field {
    filter: blur(12px);
  }

  /* Damage: accent vignette on the field edges, faded in and out by src/game/hud.ts. */
  .stage__damage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: var(--radius-card);
    box-shadow: inset 0 0 64px 8px var(--accent);
    opacity: 0;
  }

  .stage__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-6);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-radius: var(--radius-card);
  }

  .stage__overlay[hidden],
  .stage__panel[hidden] {
    display: none;
  }

  .stage__panel {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    max-inline-size: 46ch;
    text-align: center;
  }

  .stage__title {
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .stage__count {
    font-family: var(--font-display-ja);
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1;
  }

  .stage__intro {
    color: var(--muted);
  }

  .stage__actions {
    display: flex;
    gap: var(--space-3);
  }

  .stage__best {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    padding: var(--space-1) var(--space-3);
    color: var(--info);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    background: var(--info-soft);
    border-radius: var(--radius-chip);
  }

  .stage__best[hidden] {
    display: none;
  }

  .stage__level {
    position: absolute;
    inset-block-start: var(--space-6);
    inset-inline: 0;
    color: var(--info);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    text-align: center;
    pointer-events: none;
    opacity: 0;
  }

  .entry {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: center;
    justify-self: center;
    min-inline-size: min(100%, 500px);
    min-block-size: var(--target-min);
    padding-block-end: var(--space-2);
    border-block-end: 2px solid var(--line-strong);
    cursor: text;
  }

  .entry:focus-within {
    border-block-end-color: var(--info);
  }

  .entry__label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .entry__typed {
    display: inline-flex;
    min-inline-size: 1ch;
    color: var(--info);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
  }

  .entry__wrong {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .entry__kana {
    color: var(--muted);
  }

  .entry__kana:not(:empty)::before {
    content: '→ ';
  }

  .entry__focus {
    color: var(--muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* Bubbles are created from the template, outside Astro's scope. */
  .field :global(.bubble) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: flex;
    gap: var(--space-1);
    align-items: center;
    will-change: transform;
  }

  .field :global(.bubble[hidden]) {
    display: none;
  }

  .field :global(.bubble--right) {
    flex-direction: row-reverse;
  }

  .field :global(.bubble--right .bubble__arrow) {
    transform: scaleX(-1);
  }

  .field :global(.bubble__arrow) {
    color: var(--muted);
  }

  .field :global(.bubble__pill) {
    position: relative;
    padding: var(--space-1) var(--space-5);
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
  }

  .field :global(.bubble__text) {
    font-family: var(--font-display-ja);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }

  .field :global(.bubble__text .is-filled) {
    color: var(--info);
  }

  .field :global(.is-target .bubble__pill) {
    border-color: var(--info);
    box-shadow: 0 0 0 4px var(--info-soft);
  }

  .field :global(.is-danger .bubble__pill) {
    border-color: var(--accent);
    border-style: dashed;
  }

  .field :global(.bubble__mark) {
    position: absolute;
    inset-block-start: -10px;
    inset-inline-end: -6px;
    display: none;
    place-items: center;
    inline-size: 20px;
    block-size: 20px;
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    background: var(--accent);
    border-radius: var(--radius-pill);
  }

  .field :global(.is-danger .bubble__mark) {
    display: grid;
  }

  .field :global(.bubble__hint) {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    display: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: center;
  }

  .field :global(.is-hinted .bubble__hint) {
    display: block;
  }

  .field :global(.is-popping .bubble__pill) {
    animation: pop 150ms var(--ease) forwards;
  }

  /* A bubble that reaches the far edge breaks in the accent colour. */
  .field :global(.is-missed .bubble__pill) {
    color: var(--accent);
    border-color: var(--accent);
    border-style: solid;
    animation: shatter 320ms var(--ease) forwards;
  }

  .field :global(.is-popping .bubble__arrow),
  .field :global(.is-missed .bubble__arrow),
  .field :global(.is-missed .bubble__mark) {
    opacity: 0;
  }

  .field :global(.pop-note) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    color: var(--info);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: nowrap;
    pointer-events: none;
    animation: rise 900ms var(--ease) forwards;
  }

  @keyframes pop {
    to {
      opacity: 0;
      scale: 1.25;
    }
  }

  @keyframes shatter {
    30% {
      scale: 1.08;
    }

    100% {
      opacity: 0;
      scale: 0.6;
    }
  }

  @keyframes rise {
    to {
      opacity: 0;
      translate: 0 -32px;
    }
  }
</style>
