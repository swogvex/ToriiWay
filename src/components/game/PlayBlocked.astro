---
/**
 * Shown instead of the game on narrow screens or without a fine pointer (artboard 04).
 * CSS decides visibility, so phones never see the game flash first; "Play anyway"
 * appears when a keyboard is likely (src/game/play.ts).
 */
import { getLocale, localizePath, useTranslations } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<section class="blocked column" aria-labelledby="blocked-title">
  <div class="blocked__art" aria-hidden="true">
    <span class="blocked__bubble" lang="ja">
      あい
    </span>
    <span class="blocked__bubble blocked__bubble--muted" lang="ja">
      うえ
    </span>
    <Icon name="keyboard-off" size={36} class="blocked__icon" />
  </div>
  <p class="blocked__kicker">{t('game.blocked.kicker')}</p>
  <h1 id="blocked-title" class="blocked__title">
    {t('game.blocked.title')}
  </h1>
  <p class="blocked__text">{t('game.blocked.text')}</p>
  <div class="blocked__actions">
    <Button size={52} data-copy-link data-copied-label={t('game.blocked.copied')}>
      <Icon name="copy" size={20} />
      <span data-copy-label>{t('game.blocked.copy')}</span>
    </Button>
    <Button size={52} variant="outline" href={localizePath('/learn/hiragana', locale)}>
      {t('game.blocked.learn')}
    </Button>
    <Button size={52} variant="ghost" data-play-anyway hidden>
      {t('game.blocked.anyway')}
    </Button>
  </div>
  <p class="visually-hidden" role="status" data-copy-status></p>
</section>

<style>
  .blocked {
    display: grid;
    gap: var(--space-4);
    max-inline-size: 640px;
    padding-block: var(--space-12);
  }

  .blocked__art {
    position: relative;
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    padding-block: var(--space-16);
    margin-block-end: var(--space-6);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
  }

  .blocked__bubble {
    padding: var(--space-2) var(--space-6);
    font-family: var(--font-display-ja);
    font-size: var(--text-xl);
    font-weight: 700;
    border: 2px solid var(--ink);
    border-radius: var(--radius-card);
  }

  .blocked__bubble--muted {
    color: var(--muted);
    border-color: var(--line-strong);
  }

  .blocked__art :global(.blocked__icon) {
    position: absolute;
    inset-block-start: var(--space-6);
    inset-inline-end: var(--space-6);
    color: var(--accent);
  }

  .blocked__kicker {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .blocked__title {
    font-size: var(--text-xl);
    line-height: var(--leading-display);
  }

  .blocked__text {
    color: var(--muted);
  }

  .blocked__actions {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }

  .blocked__actions :global(.btn) {
    gap: var(--space-2);
  }
</style>
