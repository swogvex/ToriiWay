---
/** Beginner guides from the `guides` collection (section: learn); English until translated. */
import { getCollection, render } from 'astro:content';

import JaText from '../content/JaText.astro';
import UntranslatedNotice from '../shell/UntranslatedNotice.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { DEFAULT_LOCALE, getLocale, localizePath, useTranslations } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SCRIPTS } from '../../lib/kana/data';
import { breadcrumbList, jsonLdGraph } from '../../lib/seo';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro.url.pathname);
// getCollection, not getEntry: a missing translation is expected and getEntry warns on it.
const guides = await getCollection('guides');
const translation = guides.find((entry) => entry.id === `${locale}/${slug}`);
const guide = translation ?? guides.find((entry) => entry.id === `${DEFAULT_LOCALE}/${slug}`);
if (!guide) throw new Error(`Missing guide ${slug}`);
const contentLang = translation ? undefined : DEFAULT_LOCALE;
const t = useTranslations(locale);
const site = Astro.site ?? new URL(Astro.url.origin);
const { Content } = await render(guide);
const pageUrl = new URL(Astro.url.pathname, site);
// "what-is-hiragana" links back to the hiragana chart.
const script = SCRIPTS.find((item) => slug === `what-is-${item}`);

const breadcrumb = [
  { label: t('nav.home'), href: localizePath('/', locale) },
  { label: t('learn.title'), href: localizePath('/learn', locale) },
  { label: guide.data.title },
];

const jsonLd = jsonLdGraph(
  {
    '@type': 'LearningResource',
    name: guide.data.title,
    description: guide.data.description,
    url: pageUrl.href,
    inLanguage: contentLang ?? locale,
    educationalLevel: 'Beginner',
    dateModified: guide.data.updated.toISOString().slice(0, 10),
  },
  breadcrumbList(breadcrumb, site, pageUrl),
);
---

<BaseLayout
  title={`${guide.data.title} · ${t('site.name')}`}
  description={guide.data.description}
  breadcrumb={breadcrumb}
  jsonLd={jsonLd}
>
  {contentLang && <UntranslatedNotice />}
  <article class="guide column page-frame" lang={contentLang}>
    <SectionHeader level="h1" kicker={t('learn.guide.kicker')} title={guide.data.title} />
    <div class="guide__prose">
      {guide.data.intro?.map((paragraph) => (
        <p class="guide__lead">
          <JaText text={paragraph} />
        </p>
      ))}
      <Content />
    </div>
    {script && (
      <p>
        <a href={localizePath(`/learn/${script}`, locale)}>
          {t('learn.openChart', { script: t(`learn.${script}`).toLowerCase() })}
        </a>
      </p>
    )}
  </article>
</BaseLayout>

<style>
  .guide {
    display: grid;
    gap: var(--space-8);
  }

  /* Full width of the column (owner decision). */
  .guide__prose {
    display: grid;
    gap: var(--space-4);
  }

  .guide__lead {
    font-size: var(--text-md);
  }

  .guide__prose :global(h2) {
    margin-block-start: var(--space-8);
    font-size: var(--text-lg);
    line-height: 1.2;
    scroll-margin-block-start: var(--space-8);
  }

  .guide__prose :global(ul) {
    display: grid;
    gap: var(--space-2);
    padding-inline-start: var(--space-6);
  }

  .guide__prose :global(rt) {
    font-size: 0.6em;
  }
</style>
