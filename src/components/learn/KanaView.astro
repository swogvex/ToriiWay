---
/**
 * The Learn page for one script (artboard 08, kana part): section header, Hiragana /
 * Katakana links, the guide intro with its "In this guide" list, the chart in three
 * tabs and the detail panel. The dictionary search box arrives with the dictionary.
 */
import { getEntry, render } from 'astro:content';

import { DEFAULT_LOCALE, getLocale, localizePath, useTranslations } from '../../i18n';
import { CHART_GROUPS } from '../../lib/kana/chart';
import { getKana, KANJIVG_CREDIT, panelKana, SCRIPTS, type Script } from '../../lib/kana/data';
import JaText from '../content/JaText.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Tabs from '../ui/Tabs.astro';
import KanaChart from './KanaChart.astro';
import KanaPanel from './KanaPanel.astro';
import KanaPractice from './KanaPractice.astro';

interface Props {
  script: Script;
}

const { script } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const current = Astro.url.pathname.replace(/\/$/, '');

const items = await getKana(script);
const firstKana = items[0];
if (!firstKana) throw new Error(`No ${script} kana`);
const first = panelKana(firstKana, script, locale);

const slug = `what-is-${script}`;
const guide =
  (await getEntry('guides', `${locale}/${slug}`)) ??
  (await getEntry('guides', `${DEFAULT_LOCALE}/${slug}`));
const headings = guide ? (await render(guide)).headings.filter((h) => h.depth === 2) : [];
const guideHref = localizePath(`/learn/guide/${slug}`, locale);

// Panel data for the other kana (pages/data/kana/[script].json.ts), fetched after load.
const dataUrl = `/data/kana/${script}.json`;
---

<div class="learn column" data-kana-explorer data-kana-src={dataUrl}>
  <SectionHeader level="h1" kicker={t('learn.kicker')} title={t('learn.title')} />

  <nav class="learn-nav" aria-label={t('learn.sections')}>
    {SCRIPTS.map((item) => {
      const href = localizePath(`/learn/${item}`, locale);
      return (
        <a
          class="learn-nav__link"
          href={href}
          aria-current={href === current ? 'page' : item === script ? 'true' : undefined}
        >
          {t(`learn.${item}`)}
        </a>
      );
    })}
  </nav>

  <div class="learn__body">
    {guide && (
      <section class="learn-intro" aria-labelledby="learn-intro-title">
        <h2 class="learn-intro__title" id="learn-intro-title">
          {guide.data.title}
        </h2>
        {guide.data.intro?.map((paragraph) => (
          <p class="learn-intro__text">
            <JaText text={paragraph} />
          </p>
        ))}
        {headings.length > 0 && (
          <nav class="learn-intro__toc" aria-labelledby="learn-intro-toc">
            <h3 class="learn-intro__toc-title" id="learn-intro-toc">
              {t('learn.inGuide')}
            </h3>
            <ul>
              {headings.map((heading) => (
                <li>
                  <a href={`${guideHref}#${heading.slug}`}>
                    <JaText text={heading.text} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </section>
    )}

    <section class="learn-chart" aria-labelledby="learn-chart-title">
      <h2 class="visually-hidden" id="learn-chart-title">
        {t('learn.chartLabel', { script: t(`learn.${script}`) })}
      </h2>
      <Tabs
        id="kana-groups"
        label={t('learn.chartLabel', { script: t(`learn.${script}`) })}
        tabs={CHART_GROUPS.map((group) => ({ id: group, label: t(`learn.group.${group}`) }))}
      >
        {CHART_GROUPS.map((group) => (
          <div slot={group}>
            <KanaChart items={items} group={group} selected={first.char} />
          </div>
        ))}
      </Tabs>
      <p class="learn-chart__count" data-learned-count data-template={t('learn.learnedCount')}>
        {t('learn.learnedCount', { count: 0, total: items.length })}
      </p>
      <KanaPanel kana={first} />
      <p class="learn-chart__credit">
        <a href={KANJIVG_CREDIT.url} rel="noopener" target="_blank">
          {t('learn.credit')}
          <span class="visually-hidden">{t('a11y.newTab')}</span>
        </a>
      </p>
    </section>
  </div>
</div>

<KanaPractice items={items} script={script} dataUrl={dataUrl} />

<script>
  import { initKanaExplorer } from '../../lib/kana/explorer';
  import { initLearned } from '../../lib/kana/learned';
  import { initListen } from '../../lib/kana/listen';
  import { initPractice } from '../../lib/kana/practice-ui';
  import { localKanaProgress } from '../../lib/progress/kana';

  // One entry for the whole page keeps the number of script requests down.
  const root = document.querySelector<HTMLElement>('[data-kana-explorer]');
  const practice = document.querySelector<HTMLElement>('[data-practice]');
  if (root) {
    const progress = localKanaProgress();
    initKanaExplorer(root, progress);
    initLearned(root, progress);
    void initListen(root);
    if (practice) initPractice(practice, progress);
  }
</script>

<style>
  .learn {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-12) var(--space-16);
  }

  /* Hiragana / Katakana: a segmented row of links, the current one filled with ink. */
  .learn-nav {
    display: flex;
    justify-self: start;
    gap: var(--space-1);
    padding: var(--space-1);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
  }

  .learn-nav__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--target-min);
    padding-inline: var(--space-4);
    border-radius: calc(var(--radius-control) - 2px);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .learn-nav__link:hover {
    background: var(--key);
  }

  .learn-nav__link[aria-current] {
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
  }

  .learn__body {
    display: grid;
    gap: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--ink);
  }

  @media (width >= 64rem) {
    .learn__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }
  }

  .learn-intro {
    display: grid;
    gap: var(--space-4);
  }

  .learn-intro__title {
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .learn-intro__text {
    color: var(--muted);
  }

  .learn-intro__toc {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--line);
  }

  .learn-intro__toc-title {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .learn-intro__toc ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .learn-chart {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  .learn-chart__count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .learn-chart__credit {
    color: var(--muted);
    font-size: var(--text-2xs);
  }
</style>
