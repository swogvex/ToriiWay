---
import type { CollectionEntry } from 'astro:content';
import { getLocale, localizePath } from '../../i18n';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  copy: CollectionEntry<'site'>['data']['hero'];
}

const { copy } = Astro.props;
const locale = getLocale(Astro.url.pathname);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__text">
    <p class="hero__kicker">
      {copy.kicker}
      <span class="hero__kicker-more"> — {copy.kickerMore}</span>
    </p>
    <h1 class="hero__title" id="hero-title">
      {copy.title}
    </h1>
    <p class="hero__lead">{copy.lead}</p>
    <div class="hero__actions">
      <Button href={localizePath('/game', locale)} size={48} class="hero__play">
        {copy.primary}
        <Icon name="arrow-right" size={18} />
      </Button>
      <Button
        href={localizePath('/learn/hiragana', locale)}
        variant="outline"
        size={48}
        class="hero__start"
      >
        {copy.secondary}
      </Button>
    </div>
  </div>
  <div class="hero__art" aria-hidden="true">
    <svg class="hero__clouds" viewBox="0 0 320 260" focusable="false">
      <g class="hero__cloud hero__cloud--1">
        <rect x="0" y="0" width="64" height="7" rx="3.5"></rect>
        <rect x="18" y="12" width="92" height="7" rx="3.5"></rect>
        <rect x="6" y="24" width="48" height="7" rx="3.5"></rect>
      </g>
      <g class="hero__cloud hero__cloud--2">
        <rect x="262" y="112" width="44" height="6" rx="3"></rect>
        <rect x="244" y="123" width="76" height="6" rx="3"></rect>
      </g>
      <g class="hero__cloud hero__cloud--3">
        <rect x="14" y="238" width="70" height="6" rx="3"></rect>
        <rect x="36" y="249" width="96" height="6" rx="3"></rect>
      </g>
    </svg>
    <div class="hero__stage">
      <svg class="hero__sun" viewBox="0 0 200 100" focusable="false">
        <path d="M1 100 A99 99 0 0 1 199 100"></path>
      </svg>
      <span class="hero__torii" lang="ja">
        鳥居
      </span>
    </div>
    <div class="hero__seal-row">
      <span class="hero__seal" lang="ja">
        日本語
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gutter);
    padding-block: var(--space-12) var(--space-10);
  }

  .hero__text {
    display: grid;
    align-content: start;
    gap: var(--space-6);
  }

  .hero__kicker {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .hero__title {
    max-inline-size: 15ch;
    font-size: clamp(2.75rem, 7vw, var(--text-display));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: var(--leading-display);
  }

  .hero__lead {
    max-inline-size: 34rem;
    color: var(--muted);
    font-size: var(--text-md);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__art {
    display: none;
  }

  /* Small screens (artboard 03): one ink CTA, no lead, no glyph column. */
  @media (width < 64rem) {
    .hero__kicker-more,
    .hero__lead,
    .hero__actions :global(.hero__play) {
      display: none;
    }

    .hero__actions :global(.hero__start) {
      inline-size: 100%;
      min-block-size: 52px;
      border-color: var(--ink);
      background: var(--ink);
      color: var(--bg);
    }
  }

  @media (width >= 64rem) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      padding-block: var(--space-16);
    }

    .hero__text {
      grid-column: 1 / span 8;
    }

    .hero__art {
      position: relative;
      display: grid;
      grid-column: 9 / -1;
      align-self: center;
      justify-items: center;
      gap: var(--space-5);
      isolation: isolate;
    }
  }

  /* Slow drifting clouds behind the torii; the reduced-motion reset stops them. */
  .hero__clouds {
    position: absolute;
    inset: -12% -8%;
    z-index: -1;
    inline-size: 116%;
    block-size: 124%;
    fill: var(--line-strong);
    overflow: visible;
  }

  .hero__cloud {
    animation: hero-drift 18s var(--ease) infinite alternate;
  }

  .hero__cloud--2 {
    animation-duration: 23s;
    animation-delay: -6s;
  }

  .hero__cloud--3 {
    animation-duration: 27s;
    animation-delay: -12s;
  }

  @keyframes hero-drift {
    from {
      transform: translateX(-14px);
    }

    to {
      transform: translateX(14px);
    }
  }

  .hero__stage {
    position: relative;
    display: grid;
    place-items: center;
  }

  /* Rising-sun arc in vermilion: the art's single accent line. */
  .hero__sun {
    position: absolute;
    inset-block-start: -18%;
    inline-size: 112%;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .hero__torii {
    position: relative;
    font-family: var(--font-display-ja);
    font-size: clamp(6.5rem, 9vw, 8.5rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    user-select: none;
  }

  /* Seal (hanko) between two hairlines. */
  .hero__seal-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    inline-size: 100%;
  }

  .hero__seal-row::before,
  .hero__seal-row::after {
    flex: 1;
    block-size: 1px;
    background: var(--ink);
    content: '';
  }

  .hero__seal {
    padding: var(--space-1) var(--space-3);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-chip);
    color: var(--accent);
    font-family: var(--font-display-ja);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
  }
</style>
