---
/**
 * /library (image 09). Every card is rendered here, so the page works without JavaScript
 * and never shifts; src/lib/library/client.ts filters, searches and sorts those same
 * cards and keeps the state in the URL.
 */
import { getLocale, localizePath, useTranslations } from '../../i18n';
import type { Book } from '../../lib/library/books';
import { type BookFacts, CATEGORIES, LEVELS, RESOURCES, SORTS } from '../../lib/library/filter';
import BigGlyph from '../ui/BigGlyph.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import BookBadges from './BookBadges.astro';
import BookCover from './BookCover.astro';

interface Props {
  books: Book[];
}

const { books } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const levelLabel = (level: string) => (level === 'kana' ? t('library.level.kana') : level);

/** What the client needs to filter and sort: no markup, no bodies beyond the search text. */
const facts: BookFacts[] = books.map((book) => ({
  slug: book.slug,
  title: book.title,
  levels: book.levels,
  categories: book.categories,
  audio: book.audio,
  exercises: book.exercises,
  editions: book.editions,
  featured: book.featured,
  text: book.text,
}));
const labels = {
  count: t('library.count'),
  countOne: t('library.count.one'),
};
---

<div class="lib column page-frame" data-library data-labels={JSON.stringify(labels)}>
  <SectionHeader level="h1" kicker={t('library.kicker')} title={t('library.title')}>
    <BigGlyph glyph="本" size="md" tone="faint" class="lib__glyph" />
    <form class="lib__search" role="search" data-library-search>
      <label class="visually-hidden" for="library-query">
        {t('library.search')}
      </label>
      <Icon name="search" size={20} />
      <input
        id="library-query"
        name="q"
        type="search"
        placeholder={t('library.search')}
        autocomplete="off"
        maxlength="64"
        data-library-query
      />
    </form>
  </SectionHeader>

  <div class="lib__body">
    <div class="lib__filters" data-library-filters>
      <!-- Phones only: the filters start folded by CSS, so nothing moves after load. -->
      <button
        class="lib__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="library-filter-form"
        data-library-toggle
      >
        <Icon name="menu" size={18} />
        {t('library.filters')}
      </button>
      <form class="lib__form" id="library-filter-form" data-library-form>
        <fieldset class="lib__group">
          <legend class="lib__legend">{t('library.filter.level')}</legend>
          <div class="lib__levels">
            {LEVELS.map((level) => (
              <label class="lib__level">
                <input type="checkbox" name="level" value={level} />
                <span>{levelLabel(level)}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="lib__group">
          <legend class="lib__legend">{t('library.filter.category')}</legend>
          {CATEGORIES.map((category) => (
            <label class="lib__check">
              <input type="checkbox" name="category" value={category} />
              {t(`library.category.${category}`)}
            </label>
          ))}
        </fieldset>
        <fieldset class="lib__group">
          <legend class="lib__legend">{t('library.filter.resources')}</legend>
          {RESOURCES.map((resource) => (
            <label class="lib__check">
              <input type="checkbox" name="resources" value={resource} />
              {t(`library.resource.${resource}`)}
            </label>
          ))}
        </fieldset>
        <button class="lib__clear" type="reset" data-library-clear>
          {t('library.clear')}
        </button>
      </form>
    </div>

    <section class="lib__results" aria-labelledby="library-results-title">
      <h2 id="library-results-title" class="visually-hidden">
        {t('library.title')}
      </h2>
      <div class="lib__bar">
        <p class="visually-hidden" role="status" data-library-count></p>
        <label class="lib__sort">
          {t('library.sort')}
          <select name="sort" data-library-sort>
            {SORTS.map((sort) => (
              <option value={sort}>{t(`library.sort.${sort}`)}</option>
            ))}
          </select>
        </label>
      </div>

      <ol class="lib__list" data-library-list>
        {books.map((book) => (
          <li class="card" data-slug={book.slug}>
            <BookCover
              level={book.coverLevel}
              kanji={book.entry.data.coverKanji}
              tone={book.tone}
            />
            <div class="card__text">
              <h3 class="card__title">
                <a href={localizePath(`/library/${book.slug}`, locale)}>{book.title}</a>
              </h3>
              <p class="card__meta">
                {book.entry.data.author} ·{' '}
                {book.categories.map((category) => t(`library.category.${category}`)).join(', ')}
                {book.entry.data.pages && ` · ${book.entry.data.pages} pp`}
              </p>
              <BookBadges book={book} />
            </div>
            <span class="card__open" aria-hidden="true">
              {t('library.open')}
              <Icon name="arrow-right" size={16} />
            </span>
          </li>
        ))}
      </ol>

      <div class="lib__empty" data-library-empty hidden>
        <span class="lib__empty-glyph" lang="ja" aria-hidden="true">
          空
        </span>
        <p>{t('library.empty')}</p>
        <Button variant="outline" size={40} data-library-reset>
          {t('library.clear')}
        </Button>
      </div>

      <p class="lib__note">{t('library.note')}</p>
    </section>
  </div>

  <script type="application/json" data-library-facts set:html={JSON.stringify(facts)} />
</div>

<script>
  import { initLibrary } from '../../lib/library/client';

  const root = document.querySelector<HTMLElement>('[data-library]');
  if (root) initLibrary(root);
</script>

<style>
  .lib {
    display: grid;
    gap: var(--space-8);
  }

  .lib :global(.section-header) {
    position: relative;
  }

  .lib :global(.lib__glyph) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
  }

  .lib__search {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-block-size: 3.5rem;
    margin-block-start: var(--space-3);
    padding-inline: var(--space-4);
    border: 1px solid var(--ink);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--muted);
  }

  .lib__search:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .lib__search input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: 3rem;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-md);
    outline: none;
  }

  .lib__body {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--space-8);
    align-items: start;
  }

  .lib__toggle {
    display: none;
  }

  .lib__form {
    display: grid;
    gap: var(--space-6);
  }

  .lib__group {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    margin: 0;
    border: 0;
  }

  .lib__legend {
    margin-block-end: var(--space-2);
    padding: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .lib__levels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Level chips: real checkboxes, drawn as toggle chips (image 09). */
  .lib__level {
    position: relative;
  }

  .lib__level input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .lib__level span {
    display: grid;
    place-items: center;
    min-inline-size: var(--target-min);
    min-block-size: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    pointer-events: none;
  }

  .lib__level input:checked + span {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
  }

  .lib__level input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .lib__check {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    min-block-size: var(--target-min);
    cursor: pointer;
  }

  .lib__check input {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin: 0;
    accent-color: var(--ink);
  }

  .lib__clear {
    justify-self: start;
    min-block-size: var(--target-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent-ink);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .lib__clear:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .lib__results {
    display: grid;
    gap: var(--space-4);
  }

  .lib__bar {
    display: flex;
    justify-content: flex-end;
  }

  .lib__sort {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    color: var(--muted);
  }

  .lib__sort select {
    min-block-size: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }

  .lib__list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: flex;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .card[hidden] {
    display: none;
  }

  @media (hover: hover) {
    .card:hover {
      border-color: var(--ink);
    }
  }

  .card:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .card__text {
    display: grid;
    flex: 1;
    gap: var(--space-2);
    min-inline-size: 0;
  }

  .card__title {
    font-size: var(--text-md);
    font-weight: 700;
    line-height: 1.3;
  }

  /* The title link covers the whole card, so the card is one big target. */
  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__title a:focus-visible {
    outline: none;
  }

  .card__meta {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .card__open {
    display: inline-flex;
    flex: none;
    gap: var(--space-2);
    align-items: center;
    min-block-size: var(--target-min);
    padding-inline: var(--space-4);
    border: 1px solid var(--ink);
    border-radius: var(--radius-control);
    font-weight: 500;
  }

  .lib__empty {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    padding: var(--space-10) var(--space-6);
    color: var(--muted);
    text-align: center;
  }

  .lib__empty[hidden] {
    display: none;
  }

  .lib__empty-glyph {
    color: var(--line-strong);
    font-family: var(--font-display-ja);
    font-size: var(--text-display);
    line-height: 1;
  }

  .lib__note {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Phones: filters fold into a "Filters" disclosure above the results. */
  @media (width < 48rem) {
    .lib__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .lib__toggle {
      display: inline-flex;
      gap: var(--space-2);
      align-items: center;
      min-block-size: var(--target-min);
      padding-inline: var(--space-4);
      border: 1px solid var(--ink);
      border-radius: var(--radius-control);
      background: none;
      color: var(--ink);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .lib__toggle:focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
    }

    .lib__filters:not(.is-open) .lib__form {
      display: none;
    }

    .lib__filters.is-open .lib__form {
      margin-block-start: var(--space-4);
    }

    .card {
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .card__open {
      display: none;
    }

    .lib :global(.lib__glyph) {
      display: none;
    }
  }
</style>
