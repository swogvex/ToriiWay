---
/**
 * One video lesson (artboard 10): a typographic 16:9 thumbnail (ink, category kanji, play
 * button) and the title. A plain link to YouTube without JavaScript; the island turns it
 * into a button for the player dialog. Rendered empty inside a <template> for the island.
 */
import { getLocale, type UiKey, useTranslations } from '../../i18n';
import type { PublicVideo } from '../../lib/community/public';
import { CATEGORY_GLYPH, formatDate, watchUrl } from '../../lib/community/videos';
import Icon from '../ui/Icon.astro';

interface Props {
  video?: PublicVideo;
  /** Past the first page: revealed by "Show more". */
  hidden?: boolean;
}

const { video, hidden = false } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const category = video?.category ?? 'other';
---

<li
  class="video"
  data-video
  data-video-id={video?.id}
  data-category={category}
  data-short={video?.short ? '' : undefined}
  hidden={hidden}
>
  <a class="video__link" href={video ? watchUrl(video.id, video.short) : '#'} data-video-open>
    <!-- The kanji is a pseudo-element: axe measures contrast on aria-hidden text too. -->
    <span class="video__thumb" aria-hidden="true" data-glyph={CATEGORY_GLYPH[category]}>
      <span class="video__play">
        <Icon name="play" size={20} />
      </span>
      <span class="video__short" data-video-short hidden={!video?.short}>
        {t('community.videos.short')}
      </span>
    </span>
    <span class="video__body">
      <span class="video__title" data-video-title>
        {video?.title}
      </span>
      <span class="video__meta">
        <span data-video-category>{t(`community.videos.category.${category}` as UiKey)}</span>
        <span aria-hidden="true">·</span>
        <time datetime={video?.published} data-video-date>
          {video ? formatDate(video.published, locale) : ''}
        </time>
      </span>
    </span>
  </a>
</li>
