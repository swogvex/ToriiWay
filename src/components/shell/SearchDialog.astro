---
/**
 * ⌘K command palette (07-spec-shell). For now it searches the site's sections, which are
 * rendered here as static options and filtered in the client; kana, kanji, books and
 * videos join as their sections ship. Combobox + listbox pattern with aria-activedescendant.
 */
import { getLocale, localizePath, useTranslations } from '../../i18n';
import { SECTIONS } from '../../lib/nav';
import Dialog from '../ui/Dialog.astro';
import Icon from '../ui/Icon.astro';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<Dialog id="search-dialog" title={t('search.title')} class="search-dialog">
  <div
    class="search"
    data-search
    data-count-one={t('search.count.one')}
    data-count-other={t('search.count.other')}
    data-empty={t('search.empty')}
  >
    <label class="visually-hidden" for="search-input">
      {t('search.label')}
    </label>
    <div class="search__field">
      <Icon name="search" size={20} />
      <input
        class="search__input"
        id="search-input"
        type="search"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="go"
        placeholder={t('search.placeholder')}
        data-search-input
      />
    </div>
    <div class="search__results" id="search-results" role="listbox" aria-label={t('search.title')}>
      <div class="search__group" role="group" aria-label={t('search.group.pages')}>
        <div class="search__group-title" aria-hidden="true">
          {t('search.group.pages')}
        </div>
        {SECTIONS.map((section) => (
          <div
            class="search__option"
            id={`search-option-${section.id}`}
            role="option"
            aria-selected="false"
            data-href={localizePath(section.href, locale)}
            data-keywords={`${t(`nav.${section.id}`)} ${t(`search.keywords.${section.id}`)}`}
          >
            <Icon name={section.icon} size={20} />
            <span class="search__option-label">{t(`nav.${section.id}`)}</span>
            {section.glyph && (
              <span class="search__option-glyph" lang="ja" aria-hidden="true">
                {section.glyph}
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
    <p class="search__empty" hidden data-search-empty></p>
    <p class="visually-hidden" role="status" data-search-status></p>
    <p class="search__note">{t('search.note')}</p>
  </div>
</Dialog>

<script>
  import { initSearch } from '../../lib/search';

  const root = document.querySelector<HTMLElement>('[data-search]');
  if (root) initSearch(root);
</script>

<style>
  :global(.search-dialog) {
    margin-block-start: 12vh;
  }

  .search {
    display: grid;
    gap: var(--space-4);
  }

  .search__field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    background: var(--bg);
    color: var(--muted);
  }

  .search__field:focus-within {
    border-color: var(--ink);
  }

  /* The field draws the focus ring around the whole control. */
  .search__input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: 48px;
    border: 0;
    background: transparent;
    color: var(--ink);
    outline: none;
  }

  .search__field:has(.search__input:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .search__input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .search__results {
    max-block-size: 50dvh;
    overflow-y: auto;
  }

  .search__group-title {
    padding-block: var(--space-2);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .search__option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: var(--target-min);
    padding-inline: var(--space-3);
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  .search__option[hidden] {
    display: none;
  }

  .search__option:hover {
    background: var(--key);
  }

  /* Active option: ink fill, the same cue as the rail's current item. */
  .search__option[aria-selected='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  .search__option-label {
    flex: 1;
    font-weight: 500;
  }

  .search__option-glyph {
    font-family: var(--font-display-ja);
    font-size: var(--text-lg);
    line-height: 1;
  }

  .search__empty,
  .search__note {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
