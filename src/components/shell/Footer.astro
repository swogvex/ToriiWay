---
import { getLocale, localizePath, useTranslations, type UiKey } from '../../i18n';
import { getSiteCopy } from '../../lib/content/site';
import { parseRuby } from '../../lib/ruby';
import BrandIcon from '../ui/BrandIcon.astro';
import type { BrandName } from '../ui/brands';
import Icon from '../ui/Icon.astro';
import Kbd from '../ui/Kbd.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const site = await getSiteCopy(locale);
const year = new Date().getFullYear();

interface FooterLink {
  key: UiKey;
  href: string;
  external?: boolean;
}

const local = (path: string) => localizePath(path, locale);

const columns: { title: UiKey; links: FooterLink[] }[] = [
  {
    title: 'footer.study',
    links: [
      { key: 'nav.game', href: local('/game') },
      { key: 'nav.learn', href: local('/learn') },
      { key: 'nav.jlpt', href: local('/jlpt') },
    ],
  },
  {
    title: 'footer.community',
    links: [
      { key: 'footer.discord', href: site.social.discord, external: true },
      { key: 'footer.youtube', href: site.social.youtube, external: true },
      { key: 'nav.library', href: local('/library') },
    ],
  },
  {
    title: 'footer.legal',
    links: [
      { key: 'footer.privacy', href: local('/privacy') },
      { key: 'footer.legalNotice', href: local('/legal') },
      { key: 'footer.accessibility', href: local('/accessibility') },
      { key: 'footer.terms', href: local('/terms') },
      { key: 'footer.credits', href: local('/credits') },
    ],
  },
];

const social = (Object.entries(site.social) as [BrandName, string | undefined][]).filter(
  (entry): entry is [BrandName, string] => Boolean(entry[1]),
);
---

<footer class="footer">
  <div class="footer__inner column">
    <div class="footer__prefs">
      <LangSwitch class="footer__pref" />
      <ThemeToggle variant="button" class="footer__pref" />
    </div>

    <div class="footer__main">
      <div class="footer__brand">
        <p class="footer__phrase" lang="ja">
          {parseRuby(site.footer.phrase).map((segment) =>
            segment.reading ? (
              <ruby>
                {segment.text}
                <rp>(</rp>
                <rt>{segment.reading}</rt>
                <rp>)</rp>
              </ruby>
            ) : (
              segment.text
            ),
          )}
        </p>
        <ul class="footer__social">
          {social.map(([name, url]) => (
            <li>
              <a class="footer__social-link" href={url} target="_blank" rel="noopener">
                <BrandIcon name={name} />
                <span class="visually-hidden">
                  {t(`footer.${name}`)} {t('a11y.newTab')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {columns.map((column) => (
        <nav class="footer__column" aria-labelledby={column.title.replace('.', '-')}>
          <h2 class="footer__heading" id={column.title.replace('.', '-')}>
            {t(column.title)}
          </h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href} {...(link.external && { target: '_blank', rel: 'noopener' })}>
                  {t(link.key)}
                  {link.external && <Icon name="arrow-up-right" size={14} />}
                  {link.external && <span class="visually-hidden">{t('a11y.newTab')}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="footer__shortcuts">
      <span class="footer__shortcuts-title">{t('footer.shortcuts')}</span>
      <span>
        <Kbd>
          <span data-mod-key>Ctrl</span> K
        </Kbd>
        {t('shortcuts.search')}
      </span>
      <span>
        <Kbd>T</Kbd> {t('shortcuts.theme')}
      </span>
      <span>
        <Kbd>L</Kbd> {t('shortcuts.language')}
      </span>
      <span>
        <Kbd>?</Kbd> {t('shortcuts.help')}
      </span>
    </p>

    <div class="footer__bottom">
      <p>
        © {year} {t('site.name')}
      </p>
      <p>
        {t('footer.dictionaryData')}
        <span aria-hidden="true"> · </span>
        {t('footer.notAffiliated')}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-16);
    border-block-start: 1px solid var(--ink);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-10);
    padding-block: var(--space-10) var(--space-8);
  }

  .footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__prefs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .footer__prefs > :global(.footer__pref) {
    min-block-size: 48px;
    inline-size: 100%;
  }

  @media (width >= 64rem) {
    .footer__prefs {
      display: none;
    }
  }

  .footer__main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--gutter);
  }

  .footer__brand {
    display: grid;
    grid-column: 1 / -1;
    align-content: start;
    gap: var(--space-6);
  }

  @media (width >= 48rem) {
    .footer__main {
      grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    }

    .footer__brand {
      grid-column: auto;
    }
  }

  .footer__phrase {
    font-family: var(--font-display-ja);
    font-size: clamp(var(--text-2xl), 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.6;
    word-break: keep-all;
  }

  .footer__phrase rt {
    color: var(--muted);
    font-size: 0.25em;
    font-weight: 400;
    letter-spacing: 0.2em;
  }

  .footer__social {
    display: flex;
    gap: var(--space-2);
  }

  .footer__social-link {
    display: grid;
    place-items: center;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-control);
    color: var(--ink);
  }

  .footer__social-link:hover {
    border-color: var(--ink);
  }

  .footer__heading {
    margin-block-end: var(--space-3);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .footer__column li a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-block-size: 32px;
    text-decoration: none;
  }

  .footer__column li a:hover {
    text-decoration: underline;
  }

  .footer__shortcuts {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Keyboard hints only where a keyboard is likely. */
  @media (width >= 64rem) {
    .footer__shortcuts {
      display: flex;
    }
  }

  .footer__shortcuts > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer__shortcuts-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }
</style>
