---
/**
 * Desktop side rail (≥ 1024px), outside the content column: 76px of icons with tooltips,
 * or 240px with labels. The expanded state is stored and applied before paint.
 */
import { getLocale, localizePath, useTranslations } from '../../i18n';
import { SECTIONS, sectionCurrent } from '../../lib/nav';
import Icon from '../ui/Icon.astro';

const pathname = Astro.url.pathname;
const locale = getLocale(pathname);
const t = useTranslations(locale);
---

<nav class="rail" aria-label={t('nav.main')} data-rail>
  <a class="rail__brand" href={localizePath('/', locale)}>
    <img src="/brand/torii-mark.svg" alt="" width="40" height="40" />
    <span class="rail__label rail__brand-name">{t('site.name')}</span>
  </a>
  <ul class="rail__list">
    {SECTIONS.map((section) => (
      <li>
        <a
          class="rail__item"
          href={localizePath(section.href, locale)}
          aria-current={sectionCurrent(section, pathname)}
        >
          <Icon name={section.icon} />
          <span class="rail__label">{t(`nav.${section.id}`)}</span>
          <span class="rail__tip" aria-hidden="true">
            {t(`nav.${section.id}`)}
          </span>
        </a>
      </li>
    ))}
  </ul>
  <button class="rail__item rail__toggle" type="button" aria-pressed="false" data-rail-toggle>
    <Icon name="panel-left-open" class="rail__open" />
    <Icon name="panel-left-close" class="rail__close" />
    <span class="visually-hidden">{t('rail.labels')}</span>
    <span class="rail__tip rail__tip--always" aria-hidden="true">
      {t('rail.labels')}
    </span>
  </button>
</nav>

<style>
  .rail {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 20;
    display: none;
    flex-direction: column;
    gap: var(--space-6);
    inline-size: var(--rail);
    padding: var(--space-4) 14px;
    border-inline-end: 1px solid var(--line);
    background: var(--bg);
  }

  @media (width >= 64rem) {
    .rail {
      display: flex;
    }
  }

  :global(:root[data-rail='expanded']) .rail {
    inline-size: var(--rail-expanded);
  }

  .rail__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-block-size: 48px;
    padding-inline: 4px;
    border-radius: var(--radius-control);
    font-weight: 700;
    text-decoration: none;
  }

  .rail__list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    inline-size: 100%;
    min-block-size: 48px;
    padding: 0 13px;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--muted);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }

  .rail__item:hover {
    background: var(--key);
    color: var(--ink);
  }

  /* Current section: ink fill plus bold label, not color alone. */
  .rail__item[aria-current] {
    background: var(--ink);
    color: var(--bg);
    font-weight: 700;
  }

  .rail__toggle {
    margin-block-start: auto;
  }

  .rail__toggle :global(.rail__close),
  .rail__toggle[aria-pressed='true'] :global(.rail__open) {
    display: none;
  }

  .rail__toggle[aria-pressed='true'] :global(.rail__close) {
    display: block;
  }

  /* Collapsed: labels stay in the accessibility tree but leave the screen. */
  :global(:root:not([data-rail='expanded'])) .rail__label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Tooltip on hover and focus after 400ms; Esc hides it (data-tips-off, shell script). */
  .rail__tip {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: calc(100% + var(--space-3));
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-chip);
    background: var(--ink);
    color: var(--bg);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition: opacity var(--duration-fast) var(--ease);
  }

  /* Bridges the gap so the pointer can move onto the tooltip without losing it. */
  .rail__tip::before {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 100%;
    inline-size: var(--space-3);
    content: '';
  }

  .rail__item:hover .rail__tip,
  .rail__item:focus-visible .rail__tip {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 400ms;
  }

  .rail[data-tips-off] .rail__tip,
  :global(:root[data-rail='expanded']) .rail__tip:not(.rail__tip--always) {
    display: none;
  }
</style>
