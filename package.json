{
  "name": "nihongo-no-torii",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "vercel-build": "node scripts/db/migrate.ts && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.{css,astro}\" --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "fonts:copy": "node scripts/fonts/copy.ts",
    "fonts:subset": "node scripts/fonts/subset.ts",
    "brand:outline": "node scripts/brand/outline-wordmark.ts",
    "brand:favicons": "node scripts/brand/favicons.ts",
    "kanjivg:kana": "node scripts/kanjivg/kana.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.ts --force",
    "admin:hash": "node scripts/admin/hash.ts",
    "jlpt:audio": "node scripts/jlpt/audio.ts",
    "library:add": "node scripts/library/add.ts",
    "dictionary:import": "node --max-old-space-size=4096 scripts/dictionary/import.ts"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vercel": "11.0.17",
    "@neondatabase/serverless": "1.2.0",
    "@resvg/resvg-js": "2.6.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.4.4",
    "cuelume": "0.2.8",
    "drizzle-orm": "0.45.4",
    "preact": "11.1.1",
    "satori": "0.63.2",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/node": "11.1.9",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@vercel/blob": "2.8.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "opentype.js": "2.0.0",
    "pagefind": "1.5.2",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "18.0.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "41.0.0",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
